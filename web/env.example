# Public client env
# Copy to .env when needed: cp env.example .env
#
# W1 Free shell: leave API empty (offline IndexedDB only).
# W2 Auth + Everywhere sync: point at Go API (local or prod) and allow CORS origin.
#
# Example local: PUBLIC_API_BASE_URL=http://127.0.0.1:8080
# Example prod:  PUBLIC_API_BASE_URL=https://api.ppn.creapolis.dev
PUBLIC_API_BASE_URL=
PUBLIC_WS_URL=
PUBLIC_GOOGLE_CLIENT_ID=
