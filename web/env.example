# Copia a .env (ese archivo nunca se commitea): cp env.example .env
#
# Backend Go real. Vacío = modo local sin cuenta (Account/auth/sync ocultos).
# Vite NO hornea import.meta.env de forma fiable bajo rolldown: los valores
# llegan al bundle vía los defines __PUBLIC_*__ de vite.config.ts (referencia:
# issue #973 — un build de producción sin PUBLIC_API_BASE_URL falla el guard).
#
# Local (receta LOCAL-TESTING.md):
#   PUBLIC_API_BASE_URL=http://127.0.0.1:8090
#   PUBLIC_WS_URL=ws://127.0.0.1:8090
# Producción (variables de repo GH `vars.*`, horneadas por web-deploy.yml):
#   PUBLIC_API_BASE_URL=https://api.pepinillo.app
#   PUBLIC_WS_URL=wss://api.pepinillo.app
# OAuth (dormido hasta tener Client IDs; vacío oculta los botones):
#   PUBLIC_GOOGLE_CLIENT_ID=
#   PUBLIC_APPLE_CLIENT_ID=
# Opt-out explícito del guard de API para builds de producción sin backend
# (p. ej. e2e de UI): PEP_ALLOW_UNCONFIGURED_BUILD=1
PUBLIC_API_BASE_URL=
PUBLIC_WS_URL=
PUBLIC_GOOGLE_CLIENT_ID=
PUBLIC_APPLE_CLIENT_ID=
