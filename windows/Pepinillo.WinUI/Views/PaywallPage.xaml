<Page
    x:Class="Pepinillo.WinUI.Views.PaywallPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer Margin="{StaticResource PepinilloPageMargin}">
        <StackPanel Spacing="20" MaxWidth="720" HorizontalAlignment="Left">
            <TextBlock Text="{x:Bind ViewModel.TitleLabel, Mode=OneWay}"
                       Style="{ThemeResource TitleTextBlockStyle}"
                       FontWeight="Bold"/>
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    CornerRadius="{StaticResource PepinilloCardCornerRadius}"
                    Padding="{StaticResource PepinilloCardPaddingCompact}">
                <TextBlock Text="{x:Bind ViewModel.PriceDisclaimer, Mode=OneWay}"
                           Style="{ThemeResource BodyTextBlockStyle}"
                           TextWrapping="Wrap"
                           Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}"/>
            </Border>
            <TextBlock Text="{x:Bind ViewModel.CurrentTierLabel, Mode=OneWay}"
                       Style="{ThemeResource BodyTextBlockStyle}"
                       FontWeight="SemiBold"/>

            <TextBlock Text="{x:Bind ViewModel.FreeBlurbLabel, Mode=OneWay}"
                       Style="{ThemeResource BodyTextBlockStyle}"
                       TextWrapping="Wrap"
                       Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}"/>

            <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
                <Border Grid.Column="0"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        CornerRadius="{StaticResource PepinilloCardCornerRadius}"
                        Padding="{StaticResource PepinilloCardPadding}"
                        BorderBrush="{StaticResource PepinilloThemeAccentBrush}"
                        BorderThickness="2"
                        AutomationProperties.Name="Pepinillo Plus offer">
                    <StackPanel Spacing="12">
                        <TextBlock Text="Pepinillo+"
                                   Style="{ThemeResource SubtitleTextBlockStyle}"
                                   FontWeight="Bold"/>
                        <Border Background="{StaticResource PepinilloPremiumBadgeBrush}"
                                CornerRadius="4"
                                Padding="8,4"
                                HorizontalAlignment="Left">
                            <TextBlock Text="{x:Bind ViewModel.PepinilloPlusPurchaseType, Mode=OneWay}"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                       TextWrapping="Wrap"/>
                        </Border>
                        <TextBlock Text="{x:Bind ViewModel.PepinilloPlusPrice, Mode=OneWay}"
                                   FontSize="28"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource PepinilloThemeAccentBrush}"/>
                        <TextBlock Text="{x:Bind ViewModel.PlusFeaturesLabel, Mode=OneWay}"
                                   TextWrapping="Wrap"
                                   Style="{ThemeResource BodyTextBlockStyle}"/>
                        <Button Content="{x:Bind ViewModel.BuyPlusLabel, Mode=OneWay}"
                                Style="{ThemeResource AccentButtonStyle}"
                                IsEnabled="{x:Bind ViewModel.CanInteract, Mode=OneWay}"
                                Command="{x:Bind ViewModel.PurchasePepinilloPlusCommand}"
                                IsTabStop="True"
                                AutomationProperties.Name="Buy Pepinillo Plus"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        CornerRadius="{StaticResource PepinilloCardCornerRadius}"
                        Padding="{StaticResource PepinilloCardPadding}"
                        AutomationProperties.Name="Everywhere subscription offer">
                    <StackPanel Spacing="12">
                        <TextBlock Text="Everywhere / AI+"
                                   Style="{ThemeResource SubtitleTextBlockStyle}"
                                   FontWeight="Bold"/>
                        <TextBlock Text="{x:Bind ViewModel.SubscriptionLabel, Mode=OneWay}"
                                   Style="{ThemeResource CaptionTextBlockStyle}"/>
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <TextBlock Text="{x:Bind ViewModel.EverywhereMonthlyPrice, Mode=OneWay}"
                                       FontSize="22"
                                       FontWeight="Bold"
                                       Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                            <TextBlock Text="{x:Bind ViewModel.EverywhereAnnualPrice, Mode=OneWay}"
                                       FontSize="22"
                                       FontWeight="Bold"
                                       Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                        </StackPanel>
                        <TextBlock Text="{x:Bind ViewModel.EverywhereFeaturesLabel, Mode=OneWay}"
                                   TextWrapping="Wrap"
                                   Style="{ThemeResource BodyTextBlockStyle}"/>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="{x:Bind ViewModel.SubscribeMonthlyLabel, Mode=OneWay}"
                                    Style="{ThemeResource AccentButtonStyle}"
                                    IsEnabled="{x:Bind ViewModel.CanInteract, Mode=OneWay}"
                                    Command="{x:Bind ViewModel.SubscribeMonthlyCommand}"
                                    IsTabStop="True"
                                    AutomationProperties.Name="Subscribe monthly Everywhere"/>
                            <Button Content="{x:Bind ViewModel.SubscribeAnnualLabel, Mode=OneWay}"
                                    IsEnabled="{x:Bind ViewModel.CanInteract, Mode=OneWay}"
                                    Command="{x:Bind ViewModel.SubscribeAnnualCommand}"
                                    IsTabStop="True"
                                    AutomationProperties.Name="Subscribe annual Everywhere"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <StackPanel Orientation="Horizontal" Spacing="12">
                <Button Content="{x:Bind ViewModel.RestoreLabel, Mode=OneWay}"
                        IsEnabled="{x:Bind ViewModel.CanInteract, Mode=OneWay}"
                        Command="{x:Bind ViewModel.RestorePurchasesCommand}"
                        IsTabStop="True"
                        AutomationProperties.Name="Restore purchases"/>
                <HyperlinkButton Content="{x:Bind ViewModel.ManageStoreLabel, Mode=OneWay}"
                                 NavigateUri="ms-windows-store://account"
                                 IsTabStop="True"
                                 AutomationProperties.Name="Manage subscriptions in Microsoft Store"/>
            </StackPanel>

            <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                       Style="{ThemeResource BodyTextBlockStyle}"
                       TextWrapping="Wrap"
                       AutomationProperties.LiveSetting="Polite"/>
            <ProgressRing IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}"
                          Width="28"
                          Height="28"
                          HorizontalAlignment="Left"
                          AutomationProperties.Name="Purchase in progress"/>
        </StackPanel>
    </ScrollViewer>
</Page>
