<Page
    x:Class="Pepinillo.WinUI.Views.PaywallPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer Margin="32">
        <StackPanel Spacing="20" MaxWidth="640" HorizontalAlignment="Left">
            <TextBlock Text="Upgrade Pepinillo"
                       Style="{ThemeResource TitleTextBlockStyle}"
                       FontWeight="Bold"/>
            <TextBlock Text="{x:Bind ViewModel.PriceDisclaimer, Mode=OneWay}"
                       Style="{ThemeResource CaptionTextBlockStyle}"
                       TextWrapping="Wrap"
                       Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}"/>
            <TextBlock>
                <Run Text="Current tier: "/>
                <Run Text="{x:Bind ViewModel.CurrentTierLabel, Mode=OneWay}" FontWeight="SemiBold"/>
            </TextBlock>

            <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
                <Border Grid.Column="0"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        CornerRadius="12"
                        Padding="20">
                    <StackPanel Spacing="12">
                        <TextBlock Text="Pepinillo+"
                                   Style="{ThemeResource SubtitleTextBlockStyle}"
                                   FontWeight="Bold"/>
                        <TextBlock Text="Lifetime"
                                   Style="{ThemeResource CaptionTextBlockStyle}"/>
                        <TextBlock Text="{x:Bind ViewModel.PepinilloPlusPrice, Mode=OneWay}"
                                   FontSize="28"
                                   FontWeight="Bold"/>
                        <TextBlock Text="Flowtime, Time Blocking, unlimited local tasks, premium soundscapes, desktop power features."
                                   TextWrapping="Wrap"
                                   Style="{ThemeResource BodyTextBlockStyle}"/>
                        <Button Content="Buy Pepinillo+"
                                Style="{ThemeResource AccentButtonStyle}"
                                Command="{x:Bind ViewModel.PurchasePepinilloPlusCommand}"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        CornerRadius="12"
                        Padding="20">
                    <StackPanel Spacing="12">
                        <TextBlock Text="Everywhere / AI+"
                                   Style="{ThemeResource SubtitleTextBlockStyle}"
                                   FontWeight="Bold"/>
                        <TextBlock Text="Subscription"
                                   Style="{ThemeResource CaptionTextBlockStyle}"/>
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <TextBlock Text="{x:Bind ViewModel.EverywhereMonthlyPrice, Mode=OneWay}"
                                       FontSize="22"
                                       FontWeight="Bold"/>
                            <TextBlock Text="{x:Bind ViewModel.EverywhereAnnualPrice, Mode=OneWay}"
                                       FontSize="22"
                                       FontWeight="Bold"/>
                        </StackPanel>
                        <TextBlock Text="Cloud sync across platforms, AI reports, and cross-device entitlement."
                                   TextWrapping="Wrap"
                                   Style="{ThemeResource BodyTextBlockStyle}"/>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="Subscribe monthly"
                                    Style="{ThemeResource AccentButtonStyle}"
                                    Command="{x:Bind ViewModel.SubscribeMonthlyCommand}"/>
                            <Button Content="Subscribe annual"
                                    Command="{x:Bind ViewModel.SubscribeAnnualCommand}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                       Style="{ThemeResource BodyTextBlockStyle}"
                       TextWrapping="Wrap"/>
        </StackPanel>
    </ScrollViewer>
</Page>
