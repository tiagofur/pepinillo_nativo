<Page
    x:Class="Pepinillo.WinUI.Views.PaywallPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer Margin="{StaticResource PepinilloPageMargin}">
        <StackPanel Spacing="20" MaxWidth="640" HorizontalAlignment="Left">
            <TextBlock Text="Upgrade Pepinillo"
                       Style="{ThemeResource TitleTextBlockStyle}"
                       FontWeight="Bold"/>
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    CornerRadius="{StaticResource PepinilloCardCornerRadius}"
                    Padding="{StaticResource PepinilloCardPaddingCompact}">
                <TextBlock Text="{x:Bind ViewModel.PriceDisclaimer, Mode=OneWay}"
                           Style="{ThemeResource BodyTextBlockStyle}"
                           TextWrapping="Wrap"
                           Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}"/>
            </Border>
            <TextBlock Text="{x:Bind ViewModel.CurrentTierLabel, Mode=OneWay}"
                       Style="{ThemeResource BodyTextBlockStyle}"
                       FontWeight="SemiBold"/>

            <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
                <Border Grid.Column="0"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        CornerRadius="{StaticResource PepinilloCardCornerRadius}"
                        Padding="{StaticResource PepinilloCardPadding}"
                        BorderBrush="{StaticResource PepinilloThemeAccentBrush}"
                        BorderThickness="2">
                    <StackPanel Spacing="12">
                        <TextBlock Text="Pepinillo+"
                                   Style="{ThemeResource SubtitleTextBlockStyle}"
                                   FontWeight="Bold"/>
                        <Border Background="{StaticResource PepinilloPremiumBadgeBrush}"
                                CornerRadius="4"
                                Padding="8,4"
                                HorizontalAlignment="Left">
                            <TextBlock Text="{x:Bind ViewModel.PepinilloPlusPurchaseType, Mode=OneWay}"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="Black"
                                       TextWrapping="Wrap"/>
                        </Border>
                        <TextBlock Text="{x:Bind ViewModel.PepinilloPlusPrice, Mode=OneWay}"
                                   FontSize="28"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource PepinilloThemeAccentBrush}"/>
                        <TextBlock Text="Flowtime, Time Blocking, unlimited local tasks, premium themes (Forest, Ocean, Sunset), premium soundscapes, desktop power features."
                                   TextWrapping="Wrap"
                                   Style="{ThemeResource BodyTextBlockStyle}"/>
                        <Button Content="Buy Pepinillo+"
                                Style="{ThemeResource AccentButtonStyle}"
                                Command="{x:Bind ViewModel.PurchasePepinilloPlusCommand}"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        CornerRadius="{StaticResource PepinilloCardCornerRadius}"
                        Padding="{StaticResource PepinilloCardPadding}">
                    <StackPanel Spacing="12">
                        <TextBlock Text="Everywhere / AI+"
                                   Style="{ThemeResource SubtitleTextBlockStyle}"
                                   FontWeight="Bold"/>
                        <TextBlock Text="Subscription"
                                   Style="{ThemeResource CaptionTextBlockStyle}"/>
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <TextBlock Text="{x:Bind ViewModel.EverywhereMonthlyPrice, Mode=OneWay}"
                                       FontSize="22"
                                       FontWeight="Bold"/>
                            <TextBlock Text="{x:Bind ViewModel.EverywhereAnnualPrice, Mode=OneWay}"
                                       FontSize="22"
                                       FontWeight="Bold"/>
                        </StackPanel>
                        <TextBlock Text="Cloud sync across platforms, AI reports, and cross-device entitlement."
                                   TextWrapping="Wrap"
                                   Style="{ThemeResource BodyTextBlockStyle}"/>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="Subscribe monthly"
                                    Style="{ThemeResource AccentButtonStyle}"
                                    Command="{x:Bind ViewModel.SubscribeMonthlyCommand}"/>
                            <Button Content="Subscribe annual"
                                    Command="{x:Bind ViewModel.SubscribeAnnualCommand}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                       Style="{ThemeResource BodyTextBlockStyle}"
                       TextWrapping="Wrap"/>
        </StackPanel>
    </ScrollViewer>
</Page>
