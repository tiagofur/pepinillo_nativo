<Page
    x:Class="Pepinillo.WinUI.Views.AnalyticsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:Pepinillo.Core.Models"
    mc:Ignorable="d">

    <ScrollViewer Margin="{StaticResource PepinilloPageMargin}">
        <StackPanel Spacing="{StaticResource PepinilloSectionSpacing}" MaxWidth="800" HorizontalAlignment="Left">
            <TextBlock Text="Analytics"
                       Style="{ThemeResource TitleTextBlockStyle}"
                       FontWeight="Bold"/>
            <TextBlock Text="Local session totals from SQLite (UTC). Charts use simple ProgressBars."
                       Style="{ThemeResource BodyTextBlockStyle}"
                       Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}"/>
            <TextBlock Text="{x:Bind ViewModel.EmptyStateMessage, Mode=OneWay}"
                       Style="{ThemeResource BodyTextBlockStyle}"
                       TextWrapping="Wrap"
                       Foreground="{StaticResource PepinilloPaywallHintBrush}"/>

            <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="12">
                <Border Grid.Column="0"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        CornerRadius="{StaticResource PepinilloCardCornerRadius}"
                        Padding="{StaticResource PepinilloCardPaddingCompact}">
                    <StackPanel Spacing="4">
                        <TextBlock Text="Focus today"
                                   Style="{ThemeResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}"/>
                        <TextBlock x:Name="TodayFocusText"
                                   FontSize="24"
                                   FontWeight="Bold"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        CornerRadius="{StaticResource PepinilloCardCornerRadius}"
                        Padding="{StaticResource PepinilloCardPaddingCompact}">
                    <StackPanel Spacing="4">
                        <TextBlock Text="7-day focus"
                                   Style="{ThemeResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}"/>
                        <TextBlock x:Name="WeeklyFocusText"
                                   FontSize="24"
                                   FontWeight="Bold"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        CornerRadius="{StaticResource PepinilloCardCornerRadius}"
                        Padding="{StaticResource PepinilloCardPaddingCompact}">
                    <StackPanel Spacing="4">
                        <TextBlock Text="Current streak"
                                   Style="{ThemeResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}"/>
                        <TextBlock x:Name="StreakText"
                                   FontSize="24"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource PepinilloStreakBrush}"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="3"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        CornerRadius="{StaticResource PepinilloCardCornerRadius}"
                        Padding="{StaticResource PepinilloCardPaddingCompact}">
                    <StackPanel Spacing="4">
                        <TextBlock Text="Best streak"
                                   Style="{ThemeResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}"/>
                        <TextBlock x:Name="BestStreakText"
                                   FontSize="24"
                                   FontWeight="Bold"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Achievements (FREE) — horizontal scroll -->
            <TextBlock Text="Achievements"
                       Style="{ThemeResource SubtitleTextBlockStyle}"
                       FontWeight="SemiBold"/>
            <ScrollViewer HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Disabled"
                          HorizontalScrollMode="Enabled"
                          VerticalScrollMode="Disabled">
                <ItemsControl x:Name="AchievementsList"
                              ItemsSource="{x:Bind ViewModel.Achievements, Mode=OneWay}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="12"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="models:AchievementProgress">
                            <Border Width="180"
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    CornerRadius="{StaticResource PepinilloCardCornerRadius}"
                                    Padding="{StaticResource PepinilloCardPaddingCompact}">
                                <StackPanel Spacing="6">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Grid.Column="0"
                                                   Text="{x:Bind Title}"
                                                   FontWeight="SemiBold"
                                                   TextWrapping="Wrap"/>
                                        <TextBlock Grid.Column="1"
                                                   Text="{x:Bind StatusGlyph}"
                                                   FontSize="14"
                                                   VerticalAlignment="Top"/>
                                    </Grid>
                                    <TextBlock Text="{x:Bind Description}"
                                               Style="{ThemeResource CaptionTextBlockStyle}"
                                               TextWrapping="Wrap"
                                               Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}"/>
                                    <ProgressBar Minimum="0"
                                                 Maximum="1"
                                                 Value="{x:Bind ProgressRatio}"
                                                 Height="8"/>
                                    <TextBlock Style="{ThemeResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}">
                                        <Run Text="{x:Bind ProgressCurrent}"/>
                                        <Run Text="/"/>
                                        <Run Text="{x:Bind ProgressTarget}"/>
                                    </TextBlock>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- Weekly Review (premium details / free teaser) -->
            <Border x:Name="WeeklyReviewCard"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    CornerRadius="{StaticResource PepinilloCardCornerRadius}"
                    Padding="{StaticResource PepinilloCardPadding}">
                <StackPanel Spacing="8">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE787;"
                                  Foreground="{StaticResource PepinilloThemeAccentBrush}"/>
                        <TextBlock Text="Weekly Review"
                                   FontWeight="SemiBold"
                                   Style="{ThemeResource SubtitleTextBlockStyle}"/>
                        <Border x:Name="WeeklyPremiumBadge"
                                Background="{StaticResource PepinilloPremiumBadgeBrush}"
                                CornerRadius="4"
                                Padding="6,2"
                                VerticalAlignment="Center">
                            <TextBlock Text="Pepinillo+"
                                       FontSize="11"
                                       Foreground="White"/>
                        </Border>
                    </StackPanel>
                    <TextBlock x:Name="WeeklyReviewDetailText"
                               Style="{ThemeResource BodyTextBlockStyle}"
                               TextWrapping="Wrap"/>
                    <TextBlock x:Name="WeeklyReviewTeaserText"
                               Style="{ThemeResource BodyTextBlockStyle}"
                               TextWrapping="Wrap"
                               Foreground="{StaticResource PepinilloPaywallHintBrush}"
                               Visibility="Collapsed"/>
                    <Button x:Name="WeeklyUpgradeButton"
                            Content="Upgrade for Weekly Review"
                            Click="ReviewPaywall_Click"
                            Visibility="Collapsed"/>
                </StackPanel>
            </Border>

            <!-- Monthly Review (premium details / free teaser) -->
            <Border x:Name="MonthlyReviewCard"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    CornerRadius="{StaticResource PepinilloCardCornerRadius}"
                    Padding="{StaticResource PepinilloCardPadding}">
                <StackPanel Spacing="8">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE787;"
                                  Foreground="{StaticResource PepinilloThemeAccentBrush}"/>
                        <TextBlock Text="Monthly Review"
                                   FontWeight="SemiBold"
                                   Style="{ThemeResource SubtitleTextBlockStyle}"/>
                        <Border x:Name="MonthlyPremiumBadge"
                                Background="{StaticResource PepinilloPremiumBadgeBrush}"
                                CornerRadius="4"
                                Padding="6,2"
                                VerticalAlignment="Center">
                            <TextBlock Text="Pepinillo+"
                                       FontSize="11"
                                       Foreground="White"/>
                        </Border>
                    </StackPanel>
                    <TextBlock x:Name="MonthlyReviewDetailText"
                               Style="{ThemeResource BodyTextBlockStyle}"
                               TextWrapping="Wrap"/>
                    <TextBlock x:Name="MonthlyReviewTeaserText"
                               Style="{ThemeResource BodyTextBlockStyle}"
                               TextWrapping="Wrap"
                               Foreground="{StaticResource PepinilloPaywallHintBrush}"
                               Visibility="Collapsed"/>
                    <Button x:Name="MonthlyUpgradeButton"
                            Content="Upgrade for Monthly Review"
                            Click="ReviewPaywall_Click"
                            Visibility="Collapsed"/>
                </StackPanel>
            </Border>

            <Border Background="{StaticResource PepinilloThemeAccentBrush}"
                    CornerRadius="{StaticResource PepinilloCardCornerRadius}"
                    Padding="{StaticResource PepinilloCardPadding}">
                <StackPanel Spacing="8">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE945;" Foreground="{StaticResource PepinilloPremiumBadgeBrush}"/>
                        <TextBlock Text="Insights"
                                   FontWeight="Bold"
                                   Foreground="White"
                                   Style="{ThemeResource SubtitleTextBlockStyle}"/>
                    </StackPanel>
                    <TextBlock x:Name="AiReportText"
                               Foreground="White"
                               Style="{ThemeResource BodyTextBlockStyle}"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <!-- Export + streak protection (Pepinillo+) -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    CornerRadius="{StaticResource PepinilloCardCornerRadius}"
                    Padding="{StaticResource PepinilloCardPadding}">
                <StackPanel Spacing="10">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE8C8;"
                                  Foreground="{StaticResource PepinilloThemeAccentBrush}"/>
                        <TextBlock Text="Export"
                                   FontWeight="SemiBold"
                                   Style="{ThemeResource SubtitleTextBlockStyle}"/>
                        <Border Background="{StaticResource PepinilloPremiumBadgeBrush}"
                                CornerRadius="4"
                                Padding="6,2"
                                VerticalAlignment="Center">
                            <TextBlock Text="Pepinillo+"
                                       FontSize="11"
                                       Foreground="White"/>
                        </Border>
                    </StackPanel>
                    <TextBlock Text="Download focus history as CSV or PDF. Available with Pepinillo+ or Everywhere."
                               Style="{ThemeResource CaptionTextBlockStyle}"
                               TextWrapping="Wrap"
                               Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}"/>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Name="ExportCsvButton"
                                Content="Export CSV"
                                Click="ExportCsv_Click"/>
                        <Button x:Name="ExportPdfButton"
                                Content="Export PDF"
                                Click="ExportPdf_Click"/>
                    </StackPanel>
                    <TextBlock x:Name="ExportStatusText"
                               Style="{ThemeResource CaptionTextBlockStyle}"
                               TextWrapping="Wrap"
                               Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}"/>
                    <TextBlock x:Name="StreakProtectionText"
                               Style="{ThemeResource BodyTextBlockStyle}"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <TextBlock Text="Mode breakdown (7 days)"
                       Style="{ThemeResource SubtitleTextBlockStyle}"
                       FontWeight="SemiBold"/>
            <ItemsControl x:Name="ModeList" ItemsSource="{x:Bind ViewModel.ModeBreakdown, Mode=OneWay}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="models:ModeBreakdownItem">
                        <Grid ColumnDefinitions="120,*,80" ColumnSpacing="12" Margin="0,0,0,8">
                            <TextBlock Grid.Column="0" Text="{x:Bind ModeName}" VerticalAlignment="Center"/>
                            <ProgressBar Grid.Column="1"
                                         Minimum="0"
                                         Maximum="1"
                                         Value="{x:Bind FractionOfMax}"
                                         Height="10"
                                         VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="2"
                                       Text="{x:Bind TotalMinutes}"
                                       VerticalAlignment="Center"/>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Text="Recent sessions"
                       Style="{ThemeResource SubtitleTextBlockStyle}"
                       FontWeight="SemiBold"/>
            <ListView ItemsSource="{x:Bind ViewModel.RecentSessions, Mode=OneWay}"
                      SelectionMode="None"
                      MaxHeight="320">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:FocusSession">
                        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="12" Padding="4">
                            <TextBlock Grid.Column="0" Text="{x:Bind Mode}"/>
                            <TextBlock Grid.Column="1" Text="{x:Bind ElapsedSeconds}"/>
                            <TextBlock Grid.Column="2" Text="{x:Bind StartedAt}"/>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </StackPanel>
    </ScrollViewer>
</Page>
