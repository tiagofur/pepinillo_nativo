<Page
    x:Class="Pepinillo.WinUI.Views.AnalyticsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer Margin="32">
        <StackPanel Spacing="24" MaxWidth="800" HorizontalAlignment="Left">
            <TextBlock Text="Dashboard &amp; Analíticas de Enfoque"
                       Style="{ThemeResource TitleTextBlockStyle}" FontWeight="Bold"/>

            <!-- Metric Cards Row -->
            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="16">
                <Border Grid.Column="0"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        CornerRadius="8" Padding="20">
                    <StackPanel Spacing="4">
                        <TextBlock Text="Enfoque Hoy"
                                   Style="{ThemeResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}"/>
                        <TextBlock x:Name="TodayFocusText"
                                   FontSize="28" FontWeight="Bold"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        CornerRadius="8" Padding="20">
                    <StackPanel Spacing="4">
                        <TextBlock Text="Enfoque Semanal"
                                   Style="{ThemeResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}"/>
                        <TextBlock x:Name="WeeklyFocusText"
                                   FontSize="28" FontWeight="Bold"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        CornerRadius="8" Padding="20">
                    <StackPanel Spacing="4">
                        <TextBlock Text="Racha Actual"
                                   Style="{ThemeResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}"/>
                        <TextBlock x:Name="StreakText"
                                   FontSize="28" FontWeight="Bold" Foreground="OrangeRed"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- AI Insight Report -->
            <Border Background="{ThemeResource SystemAccentColor}"
                    CornerRadius="8" Padding="20">
                <StackPanel Spacing="8">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE945;" Foreground="Gold"/>
                        <TextBlock Text="Reporte IA Pepinillo+"
                                   FontWeight="Bold" Foreground="White"
                                   Style="{ThemeResource SubtitleTextBlockStyle}"/>
                    </StackPanel>
                    <TextBlock x:Name="AiReportText"
                               Foreground="White"
                               Style="{ThemeResource BodyTextBlockStyle}"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
