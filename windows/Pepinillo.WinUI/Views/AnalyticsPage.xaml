<Page
    x:Class="Pepinillo.WinUI.Views.AnalyticsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer Margin="32">
        <StackPanel Spacing="24" MaxWidth="800" HorizontalAlignment="Left">
            <TextBlock Text="Dashboard &amp; Analíticas de Enfoque" Style="{ThemeResource TitleTextBlockStyle}" FontWeight="Bold"/>

            <!-- Metric Cards Row -->
            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="16">
                <Border Grid.Column="0" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8" Padding="20">
                    <StackPanel Spacing="4">
                        <TextBlock Text="Enfoque Hoy" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}"/>
                        <TextBlock Text="{x:Bind ViewModel.TodayFocusMinutes, Mode=OneWay, StringFormat='{}{0} min'}" FontSize="28" FontWeight="Bold"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8" Padding="20">
                    <StackPanel Spacing="4">
                        <TextBlock Text="Enfoque Semanal" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}"/>
                        <TextBlock Text="{x:Bind ViewModel.WeeklyFocusHours, Mode=OneWay, StringFormat='{}{0} hrs'}" FontSize="28" FontWeight="Bold"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8" Padding="20">
                    <StackPanel Spacing="4">
                        <TextBlock Text="Racha Actual" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}"/>
                        <TextBlock Text="{x:Bind ViewModel.CurrentStreakDays, Mode=OneWay, StringFormat='🔥 {0} días'}" FontSize="28" FontWeight="Bold" Foreground="OrangeRed"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- AI Insight Report -->
            <Border Background="{ThemeResource SystemAccentColorDark1}" CornerRadius="8" Padding="20">
                <StackPanel Spacing="8">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE945;" Foreground="Gold"/>
                        <TextBlock Text="Reporte IA Pepinillo+" FontWeight="Bold" Foreground="White" Style="{ThemeResource SubtitleTextBlockStyle}"/>
                    </StackPanel>
                    <TextBlock Text="{x:Bind ViewModel.AiReportSummary, Mode=OneWay}" Foreground="White" Style="{ThemeResource BodyTextBlockStyle}" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
