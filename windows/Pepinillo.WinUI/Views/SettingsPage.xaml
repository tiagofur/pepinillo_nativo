<Page
    x:Class="Pepinillo.WinUI.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer Margin="{StaticResource PepinilloPageMargin}">
        <StackPanel Spacing="{StaticResource PepinilloSectionSpacing}" MaxWidth="700" HorizontalAlignment="Left">
            <TextBlock Text="{x:Bind ViewModel.TitleLabel, Mode=OneWay}"
                       Style="{ThemeResource TitleTextBlockStyle}"
                       FontWeight="Bold"/>

            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    CornerRadius="{StaticResource PepinilloCardCornerRadius}"
                    Padding="{StaticResource PepinilloCardPadding}">
                <StackPanel Spacing="16">
                    <TextBlock Text="{x:Bind ViewModel.TimerDurationsLabel, Mode=OneWay}"
                               Style="{ThemeResource SubtitleTextBlockStyle}"
                               FontWeight="SemiBold"/>
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="{x:Bind ViewModel.PomodoroFocusLabel, Mode=OneWay}" VerticalAlignment="Center"/>
                        <NumberBox Grid.Column="1"
                                   Value="{x:Bind ViewModel.Settings.PomodoroFocusMinutes, Mode=TwoWay}"
                                   SmallChange="5"
                                   Minimum="5"
                                   Maximum="120"
                                   Width="120"/>
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="{x:Bind ViewModel.ShortBreakLabel, Mode=OneWay}" VerticalAlignment="Center"/>
                        <NumberBox Grid.Column="1"
                                   Value="{x:Bind ViewModel.Settings.ShortBreakMinutes, Mode=TwoWay}"
                                   SmallChange="1"
                                   Minimum="1"
                                   Maximum="30"
                                   Width="120"/>
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="{x:Bind ViewModel.LongBreakLabel, Mode=OneWay}" VerticalAlignment="Center"/>
                        <NumberBox Grid.Column="1"
                                   Value="{x:Bind ViewModel.Settings.LongBreakMinutes, Mode=TwoWay}"
                                   SmallChange="5"
                                   Minimum="5"
                                   Maximum="60"
                                   Width="120"/>
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="{x:Bind ViewModel.LongBreakIntervalLabel, Mode=OneWay}" VerticalAlignment="Center"/>
                        <NumberBox Grid.Column="1"
                                   Value="{x:Bind ViewModel.Settings.LongBreakInterval, Mode=TwoWay}"
                                   SmallChange="1"
                                   Minimum="2"
                                   Maximum="10"
                                   Width="120"/>
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="{x:Bind ViewModel.FlowtimeTargetLabel, Mode=OneWay}" VerticalAlignment="Center"/>
                        <NumberBox Grid.Column="1"
                                   Value="{x:Bind ViewModel.Settings.FlowtimeTargetMinutes, Mode=TwoWay}"
                                   SmallChange="5"
                                   Minimum="10"
                                   Maximum="180"
                                   Width="120"/>
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="{x:Bind ViewModel.TimeBlockLabel, Mode=OneWay}" VerticalAlignment="Center"/>
                        <NumberBox Grid.Column="1"
                                   Value="{x:Bind ViewModel.Settings.TimeBlockingMinutes, Mode=TwoWay}"
                                   SmallChange="15"
                                   Minimum="15"
                                   Maximum="240"
                                   Width="120"/>
                    </Grid>
                    <ToggleSwitch Header="{x:Bind ViewModel.AutoStartBreaksLabel, Mode=OneWay}"
                                  IsOn="{x:Bind ViewModel.Settings.AutoStartBreaks, Mode=TwoWay}"
                                  IsTabStop="True"
                                  AutomationProperties.Name="Auto-start breaks"/>
                    <ToggleSwitch Header="{x:Bind ViewModel.AutoStartFocusLabel, Mode=OneWay}"
                                  IsOn="{x:Bind ViewModel.Settings.AutoStartFocusSessions, Mode=TwoWay}"
                                  IsTabStop="True"
                                  AutomationProperties.Name="Auto-start next focus after break"/>
                </StackPanel>
            </Border>

            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    CornerRadius="{StaticResource PepinilloCardCornerRadius}"
                    Padding="{StaticResource PepinilloCardPadding}">
                <StackPanel Spacing="16">
                    <TextBlock Text="{x:Bind ViewModel.AppearanceLabel, Mode=OneWay}"
                               Style="{ThemeResource SubtitleTextBlockStyle}"
                               FontWeight="SemiBold"/>
                    <RadioButtons Header="Theme"
                                  SelectedIndex="{x:Bind ViewModel.SelectedThemeIndex, Mode=TwoWay}">
                        <RadioButton Content="System"/>
                        <RadioButton Content="Light"/>
                        <RadioButton Content="Dark"/>
                        <RadioButton>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="Forest" VerticalAlignment="Center"/>
                                <Border Background="{StaticResource PepinilloPremiumBadgeBrush}"
                                        CornerRadius="4"
                                        Padding="6,2"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="Premium"
                                               FontSize="10"
                                               FontWeight="SemiBold"
                                               Foreground="Black"/>
                                </Border>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="Ocean" VerticalAlignment="Center"/>
                                <Border Background="{StaticResource PepinilloPremiumBadgeBrush}"
                                        CornerRadius="4"
                                        Padding="6,2"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="Premium"
                                               FontSize="10"
                                               FontWeight="SemiBold"
                                               Foreground="Black"/>
                                </Border>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="Sunset" VerticalAlignment="Center"/>
                                <Border Background="{StaticResource PepinilloPremiumBadgeBrush}"
                                        CornerRadius="4"
                                        Padding="6,2"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="Premium"
                                               FontSize="10"
                                               FontWeight="SemiBold"
                                               Foreground="Black"/>
                                </Border>
                            </StackPanel>
                        </RadioButton>
                    </RadioButtons>
                    <TextBlock Text="{x:Bind ViewModel.PaywallFeatureHint, Mode=OneWay}"
                               Style="{ThemeResource CaptionTextBlockStyle}"
                               Foreground="{StaticResource PepinilloPaywallHintBrush}"/>
                    <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                               Style="{ThemeResource CaptionTextBlockStyle}"
                               Foreground="{StaticResource PepinilloPaywallHintBrush}"/>
                    <Button Content="{x:Bind ViewModel.UpgradePlusLabel, Mode=OneWay}"
                            Style="{ThemeResource AccentButtonStyle}"
                            Click="Upgrade_Click"
                            HorizontalAlignment="Left"
                            IsTabStop="True"
                            AutomationProperties.Name="Upgrade to Pepinillo Plus"/>
                    <RadioButtons Header="{x:Bind ViewModel.LanguageLabel, Mode=OneWay}"
                                  SelectedIndex="{x:Bind ViewModel.SelectedLanguageIndex, Mode=TwoWay}"
                                  AutomationProperties.Name="Language">
                        <RadioButton Content="English" AutomationProperties.Name="Language English"/>
                        <RadioButton Content="Español" AutomationProperties.Name="Language Spanish"/>
                        <RadioButton Content="Português" AutomationProperties.Name="Language Portuguese"/>
                    </RadioButtons>
                    <TextBlock Text="{x:Bind ViewModel.LanguageAppliesNote, Mode=OneWay}"
                               Style="{ThemeResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextWrapping="WrapWholeWords"/>
                    <ToggleSwitch Header="{x:Bind ViewModel.MicaLabel, Mode=OneWay}"
                                  IsOn="{x:Bind ViewModel.Settings.UseMicaBackdrop, Mode=TwoWay}"
                                  IsTabStop="True"
                                  AutomationProperties.Name="Mica acrylic backdrop"/>
                </StackPanel>
            </Border>

            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    CornerRadius="{StaticResource PepinilloCardCornerRadius}"
                    Padding="{StaticResource PepinilloCardPadding}">
                <StackPanel Spacing="16">
                    <TextBlock Text="{x:Bind ViewModel.SoundscapesSectionLabel, Mode=OneWay}"
                               Style="{ThemeResource SubtitleTextBlockStyle}"
                               FontWeight="SemiBold"/>
                    <ToggleSwitch Header="{x:Bind ViewModel.EnableSoundscapesLabel, Mode=OneWay}"
                                  IsOn="{x:Bind ViewModel.Settings.EnableSoundscapes, Mode=TwoWay}"
                                  IsTabStop="True"
                                  AutomationProperties.Name="Enable soundscapes"/>
                    <ToggleSwitch Header="{x:Bind ViewModel.AutoPlaySoundscapeLabel, Mode=OneWay}"
                                  IsOn="{x:Bind ViewModel.Settings.AutoPlaySoundscapeOnFocus, Mode=TwoWay}"
                                  IsTabStop="True"
                                  AutomationProperties.Name="Auto-play preferred soundscape when focus starts"/>
                    <TextBlock Text="{x:Bind ViewModel.SoundscapesHintLabel, Mode=OneWay}"
                               Style="{ThemeResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextWrapping="WrapWholeWords"/>
                </StackPanel>
            </Border>

            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    CornerRadius="{StaticResource PepinilloCardCornerRadius}"
                    Padding="{StaticResource PepinilloCardPadding}">
                <StackPanel Spacing="16">
                    <TextBlock Text="{x:Bind ViewModel.WindowsIntegrationLabel, Mode=OneWay}"
                               Style="{ThemeResource SubtitleTextBlockStyle}"
                               FontWeight="SemiBold"/>
                    <ToggleSwitch Header="{x:Bind ViewModel.FocusAssistLabel, Mode=OneWay}"
                                  IsOn="{x:Bind ViewModel.Settings.EnableWindowsDoNotDisturbSync, Mode=TwoWay}"
                                  IsTabStop="True"
                                  AutomationProperties.Name="Sync with Focus Assist"/>
                    <TextBlock Text="{x:Bind ViewModel.FocusAssistStatus, Mode=OneWay}"
                               Style="{ThemeResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextWrapping="WrapWholeWords"/>
                    <HyperlinkButton Content="{x:Bind ViewModel.OpenFocusAssistLabel, Mode=OneWay}"
                                     NavigateUri="ms-settings:quiethours"
                                     IsTabStop="True"
                                     AutomationProperties.Name="Open Focus Assist settings"/>
                    <ToggleSwitch Header="{x:Bind ViewModel.MinimizeToTrayLabel, Mode=OneWay}"
                                  IsOn="{x:Bind ViewModel.Settings.MinimizeToSystemTrayOnClose, Mode=TwoWay}"
                                  IsTabStop="True"
                                  AutomationProperties.Name="Minimize to system tray on close"/>
                    <ToggleSwitch Header="{x:Bind ViewModel.ToastsLabel, Mode=OneWay}"
                                  IsOn="{x:Bind ViewModel.Settings.EnableToastNotifications, Mode=TwoWay}"
                                  IsTabStop="True"
                                  AutomationProperties.Name="Toast notifications"/>
                    <ToggleSwitch Header="{x:Bind ViewModel.StartupLabel, Mode=OneWay}"
                                  IsOn="{x:Bind ViewModel.Settings.LaunchAtWindowsStartup, Mode=TwoWay}"
                                  IsTabStop="True"
                                  AutomationProperties.Name="Launch Pepinillo when Windows starts"/>
                </StackPanel>
            </Border>

            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    CornerRadius="{StaticResource PepinilloCardCornerRadius}"
                    Padding="{StaticResource PepinilloCardPadding}">
                <StackPanel Spacing="12">
                    <TextBlock Text="{x:Bind ViewModel.HotkeysLabel, Mode=OneWay}"
                               Style="{ThemeResource SubtitleTextBlockStyle}"
                               FontWeight="SemiBold"/>
                    <TextBlock Text="{x:Bind ViewModel.HotkeyHint, Mode=OneWay}"
                               Style="{ThemeResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextWrapping="WrapWholeWords"/>
                    <TextBlock Text="{x:Bind ViewModel.KeyboardAcceleratorsCaption, Mode=OneWay}"
                               Style="{ThemeResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextWrapping="WrapWholeWords"
                               AutomationProperties.Name="In-app keyboard accelerators"/>
                    <TextBox Header="{x:Bind ViewModel.PlayPauseHotkeyLabel, Mode=OneWay}"
                             Text="{x:Bind ViewModel.Settings.PlayPauseHotkey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             PlaceholderText="Win+Shift+P"
                             IsTabStop="True"
                             AutomationProperties.Name="Play pause global hotkey"/>
                    <TextBox Header="{x:Bind ViewModel.SkipHotkeyLabel, Mode=OneWay}"
                             Text="{x:Bind ViewModel.Settings.SkipHotkey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             PlaceholderText="Win+Shift+S"
                             IsTabStop="True"
                             AutomationProperties.Name="Skip break global hotkey"/>
                    <TextBox Header="{x:Bind ViewModel.MiniTimerHotkeyLabel, Mode=OneWay}"
                             Text="{x:Bind ViewModel.Settings.MiniTimerHotkey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             PlaceholderText="Win+Shift+M"
                             IsTabStop="True"
                             AutomationProperties.Name="Mini timer global hotkey"/>
                    <Button Content="{x:Bind ViewModel.ResetHotkeysLabel, Mode=OneWay}"
                            Command="{x:Bind ViewModel.ResetHotkeysCommand}"
                            HorizontalAlignment="Left"
                            IsTabStop="True"
                            AutomationProperties.Name="Reset hotkeys to defaults"/>
                </StackPanel>
            </Border>

            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    CornerRadius="{StaticResource PepinilloCardCornerRadius}"
                    Padding="{StaticResource PepinilloCardPadding}">
                <StackPanel Spacing="12">
                    <TextBlock Text="{x:Bind ViewModel.HelpLabel, Mode=OneWay}"
                               Style="{ThemeResource SubtitleTextBlockStyle}"
                               FontWeight="SemiBold"/>
                    <TextBlock Text="{x:Bind ViewModel.OnboardingReplayLabel, Mode=OneWay}"
                               Style="{ThemeResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextWrapping="WrapWholeWords"/>
                    <Button Content="{x:Bind ViewModel.OnboardingReplayButtonLabel, Mode=OneWay}"
                            Command="{x:Bind ViewModel.ReplayOnboardingCommand}"
                            HorizontalAlignment="Left"
                            AutomationProperties.Name="Show welcome guide"/>
                </StackPanel>
            </Border>

            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    CornerRadius="{StaticResource PepinilloCardCornerRadius}"
                    Padding="{StaticResource PepinilloCardPadding}">
                <StackPanel Spacing="12">
                    <TextBlock Text="{x:Bind ViewModel.LegalLabel, Mode=OneWay}"
                               Style="{ThemeResource SubtitleTextBlockStyle}"
                               FontWeight="SemiBold"/>
                    <HyperlinkButton Content="{x:Bind ViewModel.PrivacyLabel, Mode=OneWay}"
                                     Click="Privacy_Click"
                                     IsTabStop="True"
                                     AutomationProperties.Name="Privacy policy"/>
                    <HyperlinkButton Content="{x:Bind ViewModel.TermsLabel, Mode=OneWay}"
                                     Click="Terms_Click"
                                     IsTabStop="True"
                                     AutomationProperties.Name="Terms of use"/>
                    <Button Content="{x:Bind ViewModel.UpgradeLabel, Mode=OneWay}"
                            Style="{ThemeResource AccentButtonStyle}"
                            Click="Upgrade_Click"
                            HorizontalAlignment="Left"
                            IsTabStop="True"
                            AutomationProperties.Name="Upgrade plan"/>
                </StackPanel>
            </Border>

            <StackPanel Orientation="Horizontal" Spacing="12">
                <Button Content="{x:Bind ViewModel.SaveLabel, Mode=OneWay}"
                        Style="{ThemeResource AccentButtonStyle}"
                        Command="{x:Bind ViewModel.SaveSettingsCommand}"
                        IsTabStop="True"
                        AutomationProperties.Name="Save settings"/>
                <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                           VerticalAlignment="Center"
                           Style="{ThemeResource CaptionTextBlockStyle}"
                           AutomationProperties.LiveSetting="Polite"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
