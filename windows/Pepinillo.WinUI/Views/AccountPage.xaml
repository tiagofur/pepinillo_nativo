<Page
    x:Class="Pepinillo.WinUI.Views.AccountPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer Margin="32">
        <StackPanel Spacing="20" MaxWidth="520" HorizontalAlignment="Left">
            <TextBlock Text="{x:Bind ViewModel.TitleLabel, Mode=OneWay}"
                       Style="{ThemeResource TitleTextBlockStyle}"
                       FontWeight="Bold"/>
            <TextBlock Text="{x:Bind ViewModel.SubtitleLabel, Mode=OneWay}"
                       Style="{ThemeResource BodyTextBlockStyle}"
                       TextWrapping="Wrap"
                       Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}"/>

            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    CornerRadius="8"
                    Padding="20"
                    AutomationProperties.Name="Account credentials">
                <StackPanel Spacing="12">
                    <TextBlock Text="{x:Bind ViewModel.AccountModeLabel, Mode=OneWay}"
                               Style="{ThemeResource SubtitleTextBlockStyle}"
                               FontWeight="SemiBold"/>

                    <TextBox Header="{x:Bind ViewModel.EmailLabel, Mode=OneWay}"
                             Text="{x:Bind ViewModel.Email, Mode=TwoWay}"
                             PlaceholderText="you@example.com"
                             IsEnabled="{x:Bind ViewModel.CanInteract, Mode=OneWay}"
                             IsTabStop="True"
                             AutomationProperties.Name="Account email"/>
                    <PasswordBox x:Name="PasswordBox"
                                 Header="{x:Bind ViewModel.PasswordLabel, Mode=OneWay}"
                                 PlaceholderText="{x:Bind ViewModel.PasswordLabel, Mode=OneWay}"
                                 PasswordChanged="PasswordBox_PasswordChanged"
                                 IsEnabled="{x:Bind ViewModel.CanInteract, Mode=OneWay}"
                                 IsTabStop="True"
                                 AutomationProperties.Name="Account password"/>
                    <TextBox Header="{x:Bind ViewModel.DisplayNameLabel, Mode=OneWay}"
                             Text="{x:Bind ViewModel.DisplayName, Mode=TwoWay}"
                             PlaceholderText="Optional"
                             IsEnabled="{x:Bind ViewModel.CanInteract, Mode=OneWay}"
                             IsTabStop="True"
                             AutomationProperties.Name="Display name"/>

                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="{x:Bind ViewModel.LoginLabel, Mode=OneWay}"
                                Style="{ThemeResource AccentButtonStyle}"
                                Command="{x:Bind ViewModel.LoginCommand}"
                                IsEnabled="{x:Bind ViewModel.CanInteract, Mode=OneWay}"
                                IsTabStop="True"
                                AutomationProperties.Name="Sign in"/>
                        <Button Content="{x:Bind ViewModel.RegisterLabel, Mode=OneWay}"
                                Command="{x:Bind ViewModel.RegisterCommand}"
                                IsEnabled="{x:Bind ViewModel.CanInteract, Mode=OneWay}"
                                IsTabStop="True"
                                AutomationProperties.Name="Register account"/>
                        <Button Content="{x:Bind ViewModel.LogoutLabel, Mode=OneWay}"
                                Command="{x:Bind ViewModel.LogoutCommand}"
                                IsEnabled="{x:Bind ViewModel.CanInteract, Mode=OneWay}"
                                IsTabStop="True"
                                AutomationProperties.Name="Sign out"/>
                    </StackPanel>

                    <Button Content="{x:Bind ViewModel.SyncNowLabel, Mode=OneWay}"
                            Command="{x:Bind ViewModel.SyncNowCommand}"
                            HorizontalAlignment="Left"
                            IsEnabled="{x:Bind ViewModel.CanInteract, Mode=OneWay}"
                            IsTabStop="True"
                            AutomationProperties.Name="Sync now"/>

                    <TextBlock Style="{ThemeResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}">
                        <Run Text="{x:Bind ViewModel.LastSyncPrefix, Mode=OneWay}"/>
                        <Run Text="{x:Bind ViewModel.LastSyncDisplay, Mode=OneWay}"/>
                    </TextBlock>

                    <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                               Style="{ThemeResource BodyTextBlockStyle}"
                               TextWrapping="Wrap"
                               AutomationProperties.LiveSetting="Polite"/>
                    <TextBlock Text="{x:Bind ViewModel.SyncStatus, Mode=OneWay}"
                               Style="{ThemeResource CaptionTextBlockStyle}"
                               TextWrapping="Wrap"
                               Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}"/>
                    <TextBlock Text="{x:Bind ViewModel.LastError, Mode=OneWay}"
                               Style="{ThemeResource CaptionTextBlockStyle}"
                               TextWrapping="Wrap"
                               Foreground="{ThemeResource SystemFillColorCriticalBrush}"/>

                    <TextBlock Text="{x:Bind ViewModel.CloudSyncHint, Mode=OneWay}"
                               Style="{ThemeResource CaptionTextBlockStyle}"
                               TextWrapping="Wrap"
                               Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}"
                               Margin="0,8,0,0"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
