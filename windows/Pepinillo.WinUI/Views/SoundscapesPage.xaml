<Page
    x:Class="Pepinillo.WinUI.Views.SoundscapesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:Pepinillo.Core.Models"
    mc:Ignorable="d">

    <ScrollViewer Margin="32">
        <StackPanel Spacing="20" MaxWidth="720" HorizontalAlignment="Left">
            <TextBlock Text="{x:Bind ViewModel.TitleLabel, Mode=OneWay}"
                       Style="{ThemeResource TitleTextBlockStyle}"
                       FontWeight="Bold"/>
            <TextBlock Text="Looping ambient audio for deep work. Premium tracks require Pepinillo+ / Everywhere."
                       Style="{ThemeResource BodyTextBlockStyle}"
                       TextWrapping="Wrap"
                       Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}"/>

            <StackPanel Spacing="8" MaxWidth="400">
                <TextBlock Text="{x:Bind ViewModel.VolumeLabel, Mode=OneWay}"/>
                <Slider Minimum="0" Maximum="1" StepFrequency="0.05"
                        Value="{x:Bind ViewModel.MasterVolume, Mode=TwoWay}"
                        ValueChanged="Volume_ValueChanged"/>
                <Button Content="Stop all" Command="{x:Bind ViewModel.StopAllCommand}" HorizontalAlignment="Left"/>
            </StackPanel>

            <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                       Style="{ThemeResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}"/>

            <ItemsControl ItemsSource="{x:Bind ViewModel.Tracks, Mode=OneWay}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="models:SoundscapeTrack">
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                CornerRadius="8"
                                Padding="16"
                                Margin="0,0,0,8">
                            <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="12">
                                <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold"/>
                                    <TextBlock Style="{ThemeResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}">
                                        <Run Text="{x:Bind Category}"/>
                                        <Run Text=" · "/>
                                        <Run Text="{x:Bind AudioFileName}"/>
                                    </TextBlock>
                                    <TextBlock Text="Premium"
                                               Foreground="Goldenrod"
                                               Style="{ThemeResource CaptionTextBlockStyle}"
                                               Visibility="{x:Bind IsPremium}"/>
                                </StackPanel>
                                <Button Grid.Column="1" Content="Play" Click="Play_Click" Tag="{x:Bind}"/>
                                <Button Grid.Column="2" Content="Stop" Click="Stop_Click" Tag="{x:Bind}"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</Page>
