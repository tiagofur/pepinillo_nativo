<Page
    x:Class="Pepinillo.WinUI.Views.TasksPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:Pepinillo.Core.Models"
    mc:Ignorable="d">

    <Grid RowDefinitions="Auto,Auto,Auto,*" Margin="{StaticResource PepinilloPageMargin}">
        <StackPanel Grid.Row="0" Spacing="8" Margin="0,0,0,24">
            <TextBlock Text="{x:Bind ViewModel.TitleLabel, Mode=OneWay}"
                       Style="{ThemeResource TitleTextBlockStyle}"
                       FontWeight="Bold"/>
            <TextBlock Text="{x:Bind ViewModel.SubtitleLabel, Mode=OneWay}"
                       Style="{ThemeResource BodyTextBlockStyle}"
                       Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}"/>
            <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                       Style="{ThemeResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Spacing="12" Margin="0,0,0,16">
            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="12">
                <TextBox Grid.Column="0"
                         PlaceholderText="{x:Bind ViewModel.AddPlaceholder, Mode=OneWay}"
                         Text="{x:Bind ViewModel.NewTaskTitle, Mode=TwoWay}"
                         Header="{x:Bind ViewModel.TitleFieldLabel, Mode=OneWay}"/>
                <NumberBox Grid.Column="1"
                           Width="140"
                           Header="{x:Bind ViewModel.EstimateLabel, Mode=OneWay}"
                           Value="{x:Bind ViewModel.NewTaskEstimateMinutes, Mode=TwoWay}"
                           SpinButtonPlacementMode="Compact"
                           SmallChange="5"
                           LargeChange="15"
                           Minimum="5"
                           Maximum="240"/>
                <Button Grid.Column="2"
                        Content="{x:Bind ViewModel.AddTaskLabel, Mode=OneWay}"
                        Style="{ThemeResource AccentButtonStyle}"
                        VerticalAlignment="Bottom"
                        Command="{x:Bind ViewModel.CreateTaskCommand}"/>
            </Grid>
            <StackPanel Orientation="Horizontal" Spacing="12">
                <NumberBox Header="{x:Bind ViewModel.PriorityLabel, Mode=OneWay}"
                           Width="140"
                           Value="{x:Bind ViewModel.NewTaskPriority, Mode=TwoWay}"
                           Minimum="0"
                           Maximum="3"
                           SmallChange="1"
                           SpinButtonPlacementMode="Compact"/>
                <ComboBox Header="{x:Bind ViewModel.EnergyLabel, Mode=OneWay}"
                          Width="140"
                          ItemsSource="{x:Bind ViewModel.EnergyOptions}"
                          SelectedItem="{x:Bind ViewModel.NewTaskEnergy, Mode=TwoWay}"/>
                <ComboBox Header="{x:Bind ViewModel.RecurrenceLabel, Mode=OneWay}"
                          Width="160"
                          ItemsSource="{x:Bind ViewModel.RecurrenceOptions}"
                          SelectedItem="{x:Bind ViewModel.NewTaskRecurrence, Mode=TwoWay}"/>
            </StackPanel>
        </StackPanel>

        <Pivot Grid.Row="2"
               x:Name="FilterPivot"
               Margin="0,0,0,8"
               SelectionChanged="FilterPivot_SelectionChanged">
            <PivotItem x:Name="FilterTodayItem" Header="Today" Tag="Today"/>
            <PivotItem x:Name="FilterUpcomingItem" Header="Upcoming" Tag="Upcoming"/>
            <PivotItem x:Name="FilterInboxItem" Header="Inbox" Tag="Inbox"/>
            <PivotItem x:Name="FilterAllItem" Header="All" Tag="All"/>
        </Pivot>

        <Grid Grid.Row="3">
            <ListView ItemsSource="{x:Bind ViewModel.Tasks, Mode=OneWay}"
                      SelectionMode="None">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:TaskItem">
                        <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto,Auto" ColumnSpacing="8" Padding="12,8">
                            <CheckBox Grid.Column="0"
                                      IsChecked="{x:Bind IsCompleted, Mode=OneWay}"
                                      MinWidth="32"
                                      Click="TaskCheck_Click"
                                      Tag="{x:Bind}"/>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                                <TextBlock Text="{x:Bind Title}"
                                           FontWeight="SemiBold"
                                           Style="{ThemeResource BodyTextBlockStyle}"
                                           TextWrapping="Wrap"/>
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <TextBlock Text="{x:Bind PriorityLabel}"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               Foreground="{ThemeResource SystemAccentColor}"/>
                                    <TextBlock Text="{x:Bind EnergyLabel}"
                                               FontSize="11"/>
                                    <TextBlock Text="{x:Bind RecurrenceRule}"
                                               FontSize="11"
                                               Opacity="0.7"/>
                                </StackPanel>
                                <ItemsControl ItemsSource="{x:Bind SubTasks}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="models:TaskItem">
                                            <StackPanel Orientation="Horizontal" Spacing="8" Margin="12,2,0,0">
                                                <CheckBox IsChecked="{x:Bind IsCompleted, Mode=OneWay}"
                                                          MinWidth="28"
                                                          Click="SubtaskCheck_Click"
                                                          Tag="{x:Bind}"/>
                                                <TextBlock Text="{x:Bind Title}"
                                                           VerticalAlignment="Center"
                                                           Style="{ThemeResource CaptionTextBlockStyle}"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                            <Border Grid.Column="2"
                                    Background="{ThemeResource SystemAccentColor}"
                                    CornerRadius="4"
                                    Padding="8,4"
                                    VerticalAlignment="Center">
                                <TextBlock Text="{x:Bind EstimatedMinutes}"
                                           Foreground="White"
                                           FontSize="12"
                                           FontWeight="SemiBold"/>
                            </Border>
                            <TextBlock Grid.Column="3"
                                       Text="{x:Bind EstimatedPomodoros}"
                                       VerticalAlignment="Center"
                                       Style="{ThemeResource CaptionTextBlockStyle}"
                                       ToolTipService.ToolTip="Estimated pomodoros"/>
                            <Button Grid.Column="4"
                                    Content="+"
                                    ToolTipService.ToolTip="Add subtask"
                                    Click="AddSubtask_Click"
                                    Tag="{x:Bind}"
                                    VerticalAlignment="Center"/>
                            <Button Grid.Column="5"
                                    Style="{ThemeResource SubtleButtonStyle}"
                                    Click="DeleteTask_Click"
                                    Tag="{x:Bind}"
                                    VerticalAlignment="Center"
                                    ToolTipService.ToolTip="Delete">
                                <FontIcon Glyph="&#xE74D;" FontSize="14"/>
                            </Button>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <StackPanel VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        Spacing="12"
                        MaxWidth="360"
                        IsHitTestVisible="{x:Bind ViewModel.IsEmpty, Mode=OneWay}"
                        Opacity="{x:Bind ViewModel.EmptyPanelOpacity, Mode=OneWay}">
                <FontIcon Glyph="&#xE9D5;"
                          FontSize="48"
                          Opacity="0.55"
                          HorizontalAlignment="Center"
                          Foreground="{StaticResource PepinilloThemeAccentBrush}"/>
                <TextBlock Text="Ready when you are"
                           Style="{ThemeResource SubtitleTextBlockStyle}"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center"/>
                <TextBlock Text="{x:Bind ViewModel.EmptyHint, Mode=OneWay}"
                           Style="{ThemeResource BodyTextBlockStyle}"
                           HorizontalAlignment="Center"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}"/>
                <Button Content="Add your first task"
                        Style="{ThemeResource AccentButtonStyle}"
                        HorizontalAlignment="Center"
                        Command="{x:Bind ViewModel.CreateTaskCommand}"
                        ToolTipService.ToolTip="Uses the title field above — type a name first"/>
            </StackPanel>
        </Grid>

        <ContentDialog x:Name="SubtaskDialog"
                       Title="{x:Bind ViewModel.AddSubtaskLabel, Mode=OneWay}"
                       PrimaryButtonText="Add"
                       CloseButtonText="Cancel"
                       DefaultButton="Primary"
                       PrimaryButtonClick="SubtaskDialog_PrimaryButtonClick">
            <TextBox x:Name="SubtaskTitleBox"
                     PlaceholderText="Subtask title"
                     Header="Title"/>
        </ContentDialog>
    </Grid>
</Page>
