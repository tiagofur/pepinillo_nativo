<Page
    x:Class="Pepinillo.WinUI.Views.TasksPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:Pepinillo.Core.Models"
    mc:Ignorable="d">

    <Grid RowDefinitions="Auto,Auto,Auto,*" Margin="32">
        <StackPanel Grid.Row="0" Spacing="8" Margin="0,0,0,24">
            <TextBlock Text="Tasks"
                       Style="{ThemeResource TitleTextBlockStyle}"
                       FontWeight="Bold"/>
            <TextBlock Text="Plan work into focus-sized tasks. Data is stored offline on this device."
                       Style="{ThemeResource BodyTextBlockStyle}"
                       Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}"/>
        </StackPanel>

        <Grid Grid.Row="1" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="12" Margin="0,0,0,16">
            <TextBox Grid.Column="0"
                     PlaceholderText="Add a new task..."
                     Text="{x:Bind ViewModel.NewTaskTitle, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     Header="Title"/>
            <NumberBox Grid.Column="1"
                       Width="140"
                       Header="Est. (min)"
                       Value="{x:Bind ViewModel.NewTaskEstimateMinutes, Mode=TwoWay}"
                       SpinButtonPlacementMode="Compact"
                       SmallChange="5"
                       LargeChange="15"
                       Minimum="5"
                       Maximum="240"/>
            <Button Grid.Column="2"
                    Content="Add task"
                    Style="{ThemeResource AccentButtonStyle}"
                    VerticalAlignment="Bottom"
                    Command="{x:Bind ViewModel.CreateTaskCommand}"/>
        </Grid>

        <Pivot Grid.Row="2"
               x:Name="FilterPivot"
               Margin="0,0,0,8"
               SelectionChanged="FilterPivot_SelectionChanged">
            <PivotItem Header="Today" Tag="Today"/>
            <PivotItem Header="Upcoming" Tag="Upcoming"/>
            <PivotItem Header="Inbox" Tag="Inbox"/>
            <PivotItem Header="All" Tag="All"/>
        </Pivot>

        <Grid Grid.Row="3">
            <ListView ItemsSource="{x:Bind ViewModel.Tasks, Mode=OneWay}"
                      SelectionMode="None">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:TaskItem">
                        <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto" ColumnSpacing="12" Padding="12,8">
                            <CheckBox Grid.Column="0"
                                      IsChecked="{x:Bind IsCompleted, Mode=OneWay}"
                                      MinWidth="32"
                                      Click="TaskCheck_Click"
                                      Tag="{x:Bind}"/>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                                <TextBlock Text="{x:Bind Title}"
                                           FontWeight="SemiBold"
                                           Style="{ThemeResource BodyTextBlockStyle}"
                                           TextWrapping="Wrap"/>
                                <ItemsControl ItemsSource="{x:Bind SubTasks}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="models:TaskItem">
                                            <StackPanel Orientation="Horizontal" Spacing="8" Margin="12,2,0,0">
                                                <CheckBox IsChecked="{x:Bind IsCompleted, Mode=OneWay}"
                                                          MinWidth="28"
                                                          Click="SubtaskCheck_Click"
                                                          Tag="{x:Bind}"/>
                                                <TextBlock Text="{x:Bind Title}"
                                                           VerticalAlignment="Center"
                                                           Style="{ThemeResource CaptionTextBlockStyle}"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                            <Border Grid.Column="2"
                                    Background="{ThemeResource SystemAccentColor}"
                                    CornerRadius="4"
                                    Padding="8,4"
                                    VerticalAlignment="Center">
                                <TextBlock Text="{x:Bind EstimatedMinutes}"
                                           Foreground="White"
                                           FontSize="12"
                                           FontWeight="SemiBold"/>
                            </Border>
                            <Button Grid.Column="3"
                                    Content="+"
                                    ToolTipService.ToolTip="Add subtask"
                                    Click="AddSubtask_Click"
                                    Tag="{x:Bind}"
                                    VerticalAlignment="Center"/>
                            <Button Grid.Column="4"
                                    Style="{ThemeResource SubtleButtonStyle}"
                                    Click="DeleteTask_Click"
                                    Tag="{x:Bind}"
                                    VerticalAlignment="Center"
                                    ToolTipService.ToolTip="Delete">
                                <FontIcon Glyph="&#xE74D;" FontSize="14"/>
                            </Button>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <StackPanel VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        Spacing="8"
                        Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                <FontIcon Glyph="&#xE9D5;" FontSize="40" Opacity="0.5"/>
                <TextBlock Text="No tasks here yet"
                           Style="{ThemeResource SubtitleTextBlockStyle}"
                           HorizontalAlignment="Center"/>
                <TextBlock Text="Add a task above, or switch filters."
                           Style="{ThemeResource CaptionTextBlockStyle}"
                           HorizontalAlignment="Center"
                           Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}"/>
            </StackPanel>
        </Grid>

        <!-- Subtask composer flyout host -->
        <ContentDialog x:Name="SubtaskDialog"
                       Title="Add subtask"
                       PrimaryButtonText="Add"
                       CloseButtonText="Cancel"
                       DefaultButton="Primary"
                       PrimaryButtonClick="SubtaskDialog_PrimaryButtonClick">
            <TextBox x:Name="SubtaskTitleBox"
                     PlaceholderText="Subtask title"
                     Header="Title"/>
        </ContentDialog>
    </Grid>
</Page>
