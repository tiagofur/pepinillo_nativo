<Page
    x:Class="Pepinillo.WinUI.Views.TasksPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:Pepinillo.Core.Models"
    mc:Ignorable="d">

    <Grid RowDefinitions="Auto,Auto,*" Margin="32">
        <!-- Title & Header -->
        <StackPanel Grid.Row="0" Spacing="8" Margin="0,0,0,24">
            <TextBlock Text="Plan de Tareas" Style="{ThemeResource TitleTextBlockStyle}" FontWeight="Bold"/>
            <TextBlock Text="Organiza tu trabajo diario en sesiones de enfoque estimadas." Style="{ThemeResource BodyTextBlockStyle}" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}"/>
        </StackPanel>

        <!-- Quick Add Bar -->
        <Grid Grid.Row="1" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="12" Margin="0,0,0,24">
            <TextBox Grid.Column="0" 
                     x:Name="NewTaskTextBox"
                     PlaceholderText="Añadir una nueva tarea..."
                     Text="{x:Bind ViewModel.NewTaskTitle, Mode=TwoWay}"
                     Header="Título de la tarea"/>
            
            <NumberBox Grid.Column="1" 
                       Width="140"
                       Header="Est. (min)"
                       Value="{x:Bind ViewModel.NewTaskEstimateMinutes, Mode=TwoWay}"
                       SpinButtonPlacementMode="Compact" 
                       SmallChange="5" LargeChange="15" Minimum="5" Maximum="240"/>

            <Button Grid.Column="2" 
                    Content="Añadir Tarea" 
                    Style="{ThemeResource AccentButtonStyle}" 
                    VerticalAlignment="Bottom"
                    Command="{x:Bind ViewModel.CreateTaskCommand}"/>
        </Grid>

        <!-- Filter Tabs & Task List -->
        <Grid Grid.Row="2" RowDefinitions="Auto,*">
            <Segmented Grid.Row="0" Margin="0,0,0,16" SelectedIndex="0">
                <SegmentedItem Content="Hoy" Tag="Today" />
                <SegmentedItem Content="Próximos" Tag="Upcoming" />
                <SegmentedItem Content="Inbox" Tag="Inbox" />
                <SegmentedItem Content="Todas" Tag="All" />
            </Segmented>

            <ListView Grid.Row="1" 
                      ItemsSource="{x:Bind ViewModel.Tasks, Mode=OneWay}"
                      SelectionMode="None">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:TaskItem">
                        <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="16" Padding="12,8">
                            <CheckBox Grid.Column="0" IsChecked="{x:Bind IsCompleted, Mode=OneWay}"/>
                            
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{x:Bind Title}" FontWeight="SemiBold" Style="{ThemeResource BodyTextBlockStyle}"/>
                                <TextBlock Text="{x:Bind Description}" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}"/>
                            </StackPanel>

                            <Border Grid.Column="2" 
                                    Background="{ThemeResource SystemAccentColorDark2}" 
                                    CornerRadius="4" Padding="8,4" VerticalAlignment="Center">
                                <TextBlock Text="{x:Bind EstimatedMinutes, TargetNullValue='25 min'}" 
                                           Foreground="White" FontSize="12" FontWeight="SemiBold"/>
                            </Border>

                            <Button Grid.Column="3" 
                                    Icon="Delete" 
                                    Style="{ThemeResource SubtleButtonStyle}" 
                                    VerticalAlignment="Center"/>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>
    </Grid>
</Page>
