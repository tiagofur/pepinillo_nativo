<Page
    x:Class="Pepinillo.WinUI.Views.TasksPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:Pepinillo.Core.Models"
    mc:Ignorable="d">

    <Page.KeyboardAccelerators>
        <KeyboardAccelerator Modifiers="Control" Key="N" Invoked="NewTaskAccelerator_Invoked"/>
    </Page.KeyboardAccelerators>

    <Grid RowDefinitions="Auto,Auto,Auto,*" Margin="{StaticResource PepinilloPageMargin}">
        <StackPanel Grid.Row="0" Spacing="6" Margin="0,0,0,20">
            <TextBlock Text="{x:Bind ViewModel.TitleLabel, Mode=OneWay}"
                       Style="{ThemeResource TitleTextBlockStyle}"
                       FontWeight="Bold"/>
            <TextBlock Text="{x:Bind ViewModel.SubtitleLabel, Mode=OneWay}"
                       Style="{ThemeResource BodyTextBlockStyle}"
                       Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}"/>
            <TextBlock Text="{x:Bind ViewModel.KeyboardHintsLabel, Mode=OneWay}"
                       Style="{ThemeResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}"
                       Opacity="0.85"
                       AutomationProperties.Name="Keyboard shortcuts"/>
            <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                       Style="{ThemeResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Spacing="10" Margin="0,0,0,12">
            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="12">
                <TextBox x:Name="NewTaskTitleBox"
                         Grid.Column="0"
                         PlaceholderText="{x:Bind ViewModel.AddPlaceholder, Mode=OneWay}"
                         Text="{x:Bind ViewModel.NewTaskTitle, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         Header="{x:Bind ViewModel.TitleFieldLabel, Mode=OneWay}"
                         IsTabStop="True"
                         KeyDown="NewTaskTitleBox_KeyDown"
                         AutomationProperties.Name="New task title"
                         AutomationProperties.HelpText="Keyboard: Ctrl+N focuses this field; Enter creates the task"/>
                <NumberBox Grid.Column="1"
                           Width="140"
                           Header="{x:Bind ViewModel.EstimateLabel, Mode=OneWay}"
                           Value="{x:Bind ViewModel.NewTaskEstimateMinutes, Mode=TwoWay}"
                           SpinButtonPlacementMode="Compact"
                           SmallChange="5"
                           LargeChange="15"
                           Minimum="5"
                           Maximum="240"
                           IsTabStop="True"
                           AutomationProperties.Name="Estimated minutes for new task"/>
                <Button Grid.Column="2"
                        Content="{x:Bind ViewModel.AddTaskLabel, Mode=OneWay}"
                        Style="{ThemeResource AccentButtonStyle}"
                        VerticalAlignment="Bottom"
                        Command="{x:Bind ViewModel.CreateTaskCommand}"
                        IsTabStop="True"
                        AutomationProperties.Name="Add task"/>
            </Grid>
            <StackPanel Orientation="Horizontal" Spacing="12">
                <NumberBox Header="{x:Bind ViewModel.PriorityLabel, Mode=OneWay}"
                           Width="140"
                           Value="{x:Bind ViewModel.NewTaskPriority, Mode=TwoWay}"
                           Minimum="0"
                           Maximum="3"
                           SmallChange="1"
                           SpinButtonPlacementMode="Compact"
                           IsTabStop="True"
                           AutomationProperties.Name="New task priority"/>
                <ComboBox Header="{x:Bind ViewModel.EnergyLabel, Mode=OneWay}"
                          Width="140"
                          ItemsSource="{x:Bind ViewModel.EnergyOptions}"
                          SelectedItem="{x:Bind ViewModel.NewTaskEnergy, Mode=TwoWay}"
                          IsTabStop="True"
                          AutomationProperties.Name="New task energy"/>
                <ComboBox Header="{x:Bind ViewModel.RecurrenceLabel, Mode=OneWay}"
                          Width="160"
                          ItemsSource="{x:Bind ViewModel.RecurrenceOptions}"
                          SelectedItem="{x:Bind ViewModel.NewTaskRecurrence, Mode=TwoWay}"
                          IsTabStop="True"
                          AutomationProperties.Name="New task recurrence"/>
            </StackPanel>
        </StackPanel>

        <Pivot Grid.Row="2"
               x:Name="FilterPivot"
               Margin="0,0,0,6"
               SelectionChanged="FilterPivot_SelectionChanged"
               AutomationProperties.Name="Task filters">
            <PivotItem x:Name="FilterTodayItem"
                       Header="Today"
                       Tag="Today"
                       AutomationProperties.Name="Filter tasks Today"/>
            <PivotItem x:Name="FilterUpcomingItem"
                       Header="Upcoming"
                       Tag="Upcoming"
                       AutomationProperties.Name="Filter tasks Upcoming"/>
            <PivotItem x:Name="FilterInboxItem"
                       Header="Inbox"
                       Tag="Inbox"
                       AutomationProperties.Name="Filter tasks Inbox"/>
            <PivotItem x:Name="FilterAllItem"
                       Header="All"
                       Tag="All"
                       AutomationProperties.Name="Filter tasks All"/>
        </Pivot>

        <Grid Grid.Row="3">
            <ListView ItemsSource="{x:Bind ViewModel.Tasks, Mode=OneWay}"
                      SelectionMode="None"
                      AutomationProperties.Name="Task list">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:TaskItem">
                        <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto" ColumnSpacing="8" Padding="8,6">
                            <CheckBox Grid.Column="0"
                                      IsChecked="{x:Bind IsCompleted, Mode=OneWay}"
                                      MinWidth="32"
                                      Click="TaskCheck_Click"
                                      Tag="{x:Bind}"
                                      IsTabStop="True"
                                      AutomationProperties.Name="Complete task"
                                      AutomationProperties.HelpText="{x:Bind Title}"/>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                <TextBlock Text="{x:Bind Title}"
                                           FontWeight="SemiBold"
                                           Style="{ThemeResource BodyTextBlockStyle}"
                                           TextWrapping="Wrap"/>
                                <!-- Compact caption chips: priority · energy · estimate -->
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Border Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                            CornerRadius="3"
                                            Padding="6,1"
                                            Visibility="{x:Bind HasPriority}">
                                        <TextBlock Text="{x:Bind PriorityLabel}"
                                                   FontSize="11"
                                                   FontWeight="SemiBold"
                                                   Foreground="{ThemeResource SystemAccentColor}"/>
                                    </Border>
                                    <Border Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                            CornerRadius="3"
                                            Padding="6,1"
                                            Visibility="{x:Bind HasEnergy}">
                                        <TextBlock Text="{x:Bind EnergyLabel}"
                                                   FontSize="11"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    </Border>
                                    <Border Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                            CornerRadius="3"
                                            Padding="6,1"
                                            Visibility="{x:Bind HasEstimate}">
                                        <TextBlock Text="{x:Bind EstimateChipLabel}"
                                                   FontSize="11"
                                                   FontWeight="SemiBold"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    </Border>
                                    <TextBlock Text="{x:Bind RecurrenceRule}"
                                               FontSize="11"
                                               Opacity="0.7"
                                               VerticalAlignment="Center"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                </StackPanel>
                                <ItemsControl ItemsSource="{x:Bind SubTasks}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="models:TaskItem">
                                            <StackPanel Orientation="Horizontal" Spacing="8" Margin="12,2,0,0">
                                                <CheckBox IsChecked="{x:Bind IsCompleted, Mode=OneWay}"
                                                          MinWidth="28"
                                                          Click="SubtaskCheck_Click"
                                                          Tag="{x:Bind}"
                                                          IsTabStop="True"
                                                          AutomationProperties.Name="Complete subtask"
                                                          AutomationProperties.HelpText="{x:Bind Title}"/>
                                                <TextBlock Text="{x:Bind Title}"
                                                           VerticalAlignment="Center"
                                                           Style="{ThemeResource CaptionTextBlockStyle}"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                            <TextBlock Grid.Column="2"
                                       Text="{x:Bind EstimatedPomodoros}"
                                       VerticalAlignment="Center"
                                       Style="{ThemeResource CaptionTextBlockStyle}"
                                       ToolTipService.ToolTip="Estimated pomodoros"
                                       AutomationProperties.Name="Estimated pomodoros"/>
                            <Button Grid.Column="3"
                                    Content="+"
                                    ToolTipService.ToolTip="Add subtask"
                                    Click="AddSubtask_Click"
                                    Tag="{x:Bind}"
                                    VerticalAlignment="Center"
                                    IsTabStop="True"
                                    AutomationProperties.Name="Add subtask"/>
                            <Button Grid.Column="4"
                                    Style="{ThemeResource SubtleButtonStyle}"
                                    Click="DeleteTask_Click"
                                    Tag="{x:Bind}"
                                    VerticalAlignment="Center"
                                    ToolTipService.ToolTip="Delete"
                                    IsTabStop="True"
                                    AutomationProperties.Name="Delete task">
                                <FontIcon Glyph="&#xE74D;" FontSize="14"/>
                            </Button>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <StackPanel VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        Spacing="12"
                        MaxWidth="360"
                        IsHitTestVisible="{x:Bind ViewModel.IsEmpty, Mode=OneWay}"
                        Opacity="{x:Bind ViewModel.EmptyPanelOpacity, Mode=OneWay}"
                        AutomationProperties.Name="Empty task list">
                <FontIcon Glyph="&#xE9D5;"
                          FontSize="48"
                          Opacity="0.55"
                          HorizontalAlignment="Center"
                          Foreground="{StaticResource PepinilloThemeAccentBrush}"/>
                <TextBlock Text="{x:Bind ViewModel.EmptyTitle, Mode=OneWay}"
                           Style="{ThemeResource SubtitleTextBlockStyle}"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center"/>
                <TextBlock Text="{x:Bind ViewModel.EmptyHint, Mode=OneWay}"
                           Style="{ThemeResource BodyTextBlockStyle}"
                           HorizontalAlignment="Center"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}"/>
                <Button Content="{x:Bind ViewModel.EmptyCtaLabel, Mode=OneWay}"
                        Style="{ThemeResource AccentButtonStyle}"
                        HorizontalAlignment="Center"
                        Click="EmptyCta_Click"
                        ToolTipService.ToolTip="Focus the title field above to type a new task"
                        IsTabStop="True"
                        AutomationProperties.Name="Add a task"/>
            </StackPanel>
        </Grid>

        <ContentDialog x:Name="SubtaskDialog"
                       Title="{x:Bind ViewModel.AddSubtaskLabel, Mode=OneWay}"
                       PrimaryButtonText="Add"
                       CloseButtonText="Cancel"
                       DefaultButton="Primary"
                       PrimaryButtonClick="SubtaskDialog_PrimaryButtonClick">
            <TextBox x:Name="SubtaskTitleBox"
                     PlaceholderText="Subtask title"
                     Header="Title"
                     KeyDown="SubtaskTitleBox_KeyDown"
                     AutomationProperties.Name="Subtask title"/>
        </ContentDialog>
    </Grid>
</Page>
