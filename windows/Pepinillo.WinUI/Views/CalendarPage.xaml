<Page
    x:Class="Pepinillo.WinUI.Views.CalendarPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:Pepinillo.Core.Models"
    mc:Ignorable="d">

    <Grid Margin="{StaticResource PepinilloPageMargin}" RowDefinitions="Auto,Auto,*" ColumnDefinitions="280,*" ColumnSpacing="24" RowSpacing="16">
        <!-- Header spans full width -->
        <StackPanel Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Spacing="6">
            <TextBlock Text="{x:Bind ViewModel.TitleLabel, Mode=OneWay}"
                       Style="{ThemeResource TitleTextBlockStyle}"
                       FontWeight="Bold"/>
            <TextBlock Text="{x:Bind ViewModel.SubtitleLabel, Mode=OneWay}"
                       Style="{ThemeResource BodyTextBlockStyle}"
                       Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}"
                       TextWrapping="WrapWholeWords"/>
            <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                       Style="{ThemeResource CaptionTextBlockStyle}"
                       Foreground="{StaticResource PepinilloPaywallHintBrush}"
                       TextWrapping="WrapWholeWords"/>
        </StackPanel>

        <!-- Day chrome -->
        <Grid Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" ColumnDefinitions="Auto,*,Auto,Auto,Auto" ColumnSpacing="8">
            <Button Grid.Column="0"
                    Content="{x:Bind ViewModel.PrevDayLabel, Mode=OneWay}"
                    Command="{x:Bind ViewModel.PrevDayCommand}"
                    IsTabStop="True"
                    AutomationProperties.Name="Previous day"/>
            <TextBlock Grid.Column="1"
                       Text="{x:Bind ViewModel.DayLabel, Mode=OneWay}"
                       Style="{ThemeResource SubtitleTextBlockStyle}"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Center"
                       AutomationProperties.Name="Selected day"/>
            <Button Grid.Column="2"
                    Content="{x:Bind ViewModel.TodayLabel, Mode=OneWay}"
                    Command="{x:Bind ViewModel.GoTodayCommand}"
                    IsTabStop="True"
                    AutomationProperties.Name="Go to today"/>
            <Button Grid.Column="3"
                    Content="{x:Bind ViewModel.NextDayLabel, Mode=OneWay}"
                    Command="{x:Bind ViewModel.NextDayCommand}"
                    IsTabStop="True"
                    AutomationProperties.Name="Next day"/>
            <ComboBox Grid.Column="4"
                      MinWidth="180"
                      Header="{x:Bind ViewModel.LinkTaskLabel, Mode=OneWay}"
                      ItemsSource="{x:Bind ViewModel.AvailableTasks, Mode=OneWay}"
                      SelectedItem="{x:Bind ViewModel.SelectedTask, Mode=TwoWay}"
                      DisplayMemberPath="Title"
                      IsTabStop="True"
                      AutomationProperties.Name="Link task optional"/>
        </Grid>

        <!-- Hour column -->
        <Border Grid.Row="2" Grid.Column="0"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                CornerRadius="{StaticResource PepinilloCardCornerRadius}"
                Padding="{StaticResource PepinilloCardPaddingCompact}">
            <Grid RowDefinitions="Auto,*">
                <TextBlock Grid.Row="0"
                           Text="{x:Bind ViewModel.HoursHeadingLabel, Mode=OneWay}"
                           Style="{ThemeResource BodyStrongTextBlockStyle}"
                           Margin="0,0,0,8"/>
                <ListView Grid.Row="1"
                          ItemsSource="{x:Bind ViewModel.HourSlots, Mode=OneWay}"
                          SelectionMode="None"
                          AutomationProperties.Name="Hour slots">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:CalendarHourSlot">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" Padding="4,2">
                                <TextBlock Grid.Column="0"
                                           Text="{x:Bind HourLabel}"
                                           VerticalAlignment="Center"
                                           Style="{ThemeResource BodyTextBlockStyle}"/>
                                <Button Grid.Column="1"
                                        Content="{x:Bind AddButtonLabel}"
                                        Tag="{x:Bind HourLocal}"
                                        Click="AddAtHour_Click"
                                        Style="{ThemeResource AccentButtonStyle}"
                                        IsTabStop="True"
                                        AutomationProperties.Name="{x:Bind AutomationName}"/>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Border>

        <!-- Planned blocks -->
        <Border Grid.Row="2" Grid.Column="1"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                CornerRadius="{StaticResource PepinilloCardCornerRadius}"
                Padding="{StaticResource PepinilloCardPaddingCompact}"
                BorderBrush="{StaticResource FocusModeTimeBlockBrush}"
                BorderThickness="0,0,0,0">
            <Grid RowDefinitions="Auto,*">
                <TextBlock Grid.Row="0"
                           Text="{x:Bind ViewModel.BlocksHeadingLabel, Mode=OneWay}"
                           Style="{ThemeResource BodyStrongTextBlockStyle}"
                           Margin="0,0,0,8"/>
                <Grid Grid.Row="1">
                    <ListView ItemsSource="{x:Bind ViewModel.PlannedBlocks, Mode=OneWay}"
                              SelectionMode="None"
                              AutomationProperties.Name="Planned time blocks">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:CalendarBlockRow">
                                <Border Background="{StaticResource FocusModeTimeBlockSubtleBrush}"
                                        CornerRadius="{StaticResource PepinilloChipCornerRadius}"
                                        Padding="12,10"
                                        Margin="0,0,0,8">
                                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8" RowDefinitions="Auto,Auto,Auto">
                                        <TextBlock Grid.Row="0" Grid.Column="0"
                                                   Text="{x:Bind Title}"
                                                   Style="{ThemeResource BodyStrongTextBlockStyle}"
                                                   Foreground="{StaticResource FocusModeTimeBlockBrush}"/>
                                        <TextBlock Grid.Row="1" Grid.Column="0"
                                                   Text="{x:Bind TimeRangeLabel}"
                                                   Style="{ThemeResource BodyTextBlockStyle}"/>
                                        <TextBlock Grid.Row="2" Grid.Column="0"
                                                   Text="{x:Bind DurationLabel}"
                                                   Style="{ThemeResource CaptionTextBlockStyle}"
                                                   Opacity="0.85"/>
                                        <TextBlock Grid.Row="2" Grid.Column="0"
                                                   Text="{x:Bind TaskTitle}"
                                                   Style="{ThemeResource CaptionTextBlockStyle}"
                                                   Margin="0,16,0,0"
                                                   Opacity="0.9"
                                                   Visibility="{x:Bind HasTask}"/>
                                        <Button Grid.Row="0" Grid.Column="1" Grid.RowSpan="3"
                                                Content="Start"
                                                Tag="{x:Bind}"
                                                Click="StartBlock_Click"
                                                Style="{ThemeResource AccentButtonStyle}"
                                                VerticalAlignment="Center"
                                                IsTabStop="True"
                                                AutomationProperties.Name="Start time block"/>
                                        <Button Grid.Row="0" Grid.Column="2" Grid.RowSpan="3"
                                                Content="Delete"
                                                Tag="{x:Bind}"
                                                Click="DeleteBlock_Click"
                                                VerticalAlignment="Center"
                                                IsTabStop="True"
                                                AutomationProperties.Name="Delete time block"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <StackPanel VerticalAlignment="Center"
                                HorizontalAlignment="Center"
                                Spacing="8"
                                Opacity="0.85"
                                Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay}">
                        <FontIcon Glyph="&#xE787;" FontSize="32"
                                  Foreground="{StaticResource FocusModeTimeBlockBrush}"/>
                        <TextBlock Text="{x:Bind ViewModel.EmptyHint, Mode=OneWay}"
                                   Style="{ThemeResource BodyTextBlockStyle}"
                                   TextAlignment="Center"
                                   TextWrapping="WrapWholeWords"
                                   MaxWidth="360"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Page>
