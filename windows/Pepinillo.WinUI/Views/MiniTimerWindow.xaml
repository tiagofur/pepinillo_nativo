<Window
    x:Class="Pepinillo.WinUI.Views.MiniTimerWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Pepinillo Mini">

    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}" Padding="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
            <TextBlock x:Name="TimerText"
                       Text="25:00"
                       FontSize="{StaticResource PepinilloMiniTimerFontSize}"
                       FontWeight="Bold"
                       FontFamily="Segoe UI Variable Display"
                       Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
            <TextBlock x:Name="StatusText"
                       Text="Ready"
                       FontSize="11"
                       Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}"/>
            <TextBlock x:Name="TaskText"
                       Text="Free focus"
                       FontSize="11"
                       TextTrimming="CharacterEllipsis"
                       MaxWidth="160"
                       Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}"/>
        </StackPanel>

        <StackPanel Grid.Column="1"
                    Orientation="Horizontal"
                    Spacing="6"
                    VerticalAlignment="Center">
            <Button x:Name="PlayPauseButton"
                    Style="{ThemeResource AccentButtonStyle}"
                    Click="OnPlayPauseClick"
                    ToolTipService.ToolTip="Start / Pause"
                    Width="36"
                    Height="36"
                    Padding="0">
                <FontIcon x:Name="PlayPauseIcon" Glyph="&#xE768;" FontSize="14"/>
            </Button>
            <Button x:Name="StopButton"
                    Click="OnStopClick"
                    ToolTipService.ToolTip="Stop"
                    Width="36"
                    Height="36"
                    Padding="0">
                <FontIcon Glyph="&#xE71A;" FontSize="14"/>
            </Button>
        </StackPanel>
    </Grid>
</Window>
