<Window
    x:Class="Pepinillo.WinUI.Views.MiniTimerWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Pepinillo Mini">

    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}" Padding="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" VerticalAlignment="Center">
            <TextBlock x:Name="TimerText" Text="25:00" FontSize="28" FontWeight="Bold" FontFamily="Consolas"/>
            <TextBlock x:Name="TaskText" Text="Trabajo Enfocado" FontSize="11" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}"/>
        </StackPanel>

        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
            <Button x:Name="PlayPauseButton" Style="{ThemeResource AccentButtonStyle}" Click="OnPlayPauseClick">
                <FontIcon Glyph="&#xE769;" FontSize="14"/>
            </Button>
            <Button x:Name="StopButton" Click="OnStopClick">
                <FontIcon Glyph="&#xE71A;" FontSize="14"/>
            </Button>
        </StackPanel>
    </Grid>
</Window>
