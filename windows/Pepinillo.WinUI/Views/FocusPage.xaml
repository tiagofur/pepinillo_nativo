<Page
    x:Class="Pepinillo.WinUI.Views.FocusPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:Pepinillo.Core.Models"
    mc:Ignorable="d">

    <ScrollViewer>
        <Grid Padding="{StaticResource PepinilloPageMargin}" MaxWidth="720" HorizontalAlignment="Center">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Spacing="4" Margin="0,0,0,16">
                <TextBlock Text="{x:Bind ViewModel.TitleLabel, Mode=OneWay}"
                           Style="{ThemeResource TitleTextBlockStyle}"
                           FontWeight="Bold"/>
                <TextBlock Text="{x:Bind ViewModel.StatusLabel, Mode=OneWay}"
                           Style="{ThemeResource BodyTextBlockStyle}"
                           Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}"/>
                <TextBlock Text="{x:Bind ViewModel.ActiveTaskTitle, Mode=OneWay}"
                           Style="{ThemeResource CaptionTextBlockStyle}"/>
                <TextBlock Text="{x:Bind ViewModel.PaywallFeatureHint, Mode=OneWay}"
                           Style="{ThemeResource CaptionTextBlockStyle}"
                           Foreground="{StaticResource PepinilloPaywallHintBrush}"/>
                <TextBlock Text="{x:Bind ViewModel.SoundscapeChipLabel, Mode=OneWay}"
                           Style="{ThemeResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           Margin="0,4,0,0"/>
            </StackPanel>

            <StackPanel Grid.Row="1"
                        Orientation="Horizontal"
                        Spacing="{StaticResource PepinilloChipSpacing}"
                        Margin="0,0,0,12">
                <Button Content="Pomodoro"
                        Click="Pomodoro_Click"
                        BorderBrush="{StaticResource FocusModePomodoroBrush}"
                        Background="{StaticResource FocusModePomodoroSubtleBrush}"
                        CornerRadius="{StaticResource PepinilloChipCornerRadius}"
                        BorderThickness="2"
                        Padding="12,8"/>
                <Button Content="Stopwatch"
                        Click="Stopwatch_Click"
                        BorderBrush="{StaticResource FocusModeStopwatchBrush}"
                        Background="{StaticResource FocusModeStopwatchSubtleBrush}"
                        CornerRadius="{StaticResource PepinilloChipCornerRadius}"
                        BorderThickness="2"
                        Padding="12,8"/>
                <Button Content="Flowtime"
                        Click="Flowtime_Click"
                        BorderBrush="{StaticResource FocusModeFlowtimeBrush}"
                        Background="{StaticResource FocusModeFlowtimeSubtleBrush}"
                        CornerRadius="{StaticResource PepinilloChipCornerRadius}"
                        BorderThickness="2"
                        Padding="12,8"/>
                <Button Content="Time Block"
                        Click="TimeBlock_Click"
                        BorderBrush="{StaticResource FocusModeTimeBlockBrush}"
                        Background="{StaticResource FocusModeTimeBlockSubtleBrush}"
                        CornerRadius="{StaticResource PepinilloChipCornerRadius}"
                        BorderThickness="2"
                        Padding="12,8"/>
            </StackPanel>

            <!-- Mode Intelligence: paid suggestion banner -->
            <Border Grid.Row="2"
                    Visibility="{x:Bind ViewModel.ShowModeSuggestion, Mode=OneWay}"
                    Background="{StaticResource ModeIntelligenceBannerBrush}"
                    BorderBrush="{StaticResource ModeIntelligenceAccentBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource PepinilloCardCornerRadius}"
                    Padding="{StaticResource PepinilloCardPaddingCompact}"
                    Margin="0,0,0,16"
                    AutomationProperties.Name="Mode Intelligence suggestion">
                <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="12">
                    <FontIcon Grid.Column="0"
                              Glyph="&#xE945;"
                              FontSize="18"
                              Foreground="{StaticResource ModeIntelligenceAccentBrush}"
                              VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                        <TextBlock FontWeight="SemiBold"
                                   Style="{ThemeResource BodyTextBlockStyle}">
                            <Run Text="Try "/><Run Text="{x:Bind ViewModel.SuggestedModeLabel, Mode=OneWay}"/>
                        </TextBlock>
                        <TextBlock Text="{x:Bind ViewModel.SuggestionReason, Mode=OneWay}"
                                   Style="{ThemeResource CaptionTextBlockStyle}"
                                   TextWrapping="Wrap"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>
                    <Button Grid.Column="2"
                            Content="Apply"
                            Style="{ThemeResource AccentButtonStyle}"
                            Command="{x:Bind ViewModel.ApplySuggestionCommand}"
                            MinWidth="80"
                            VerticalAlignment="Center"
                            AutomationProperties.Name="Apply mode suggestion"/>
                    <Button Grid.Column="3"
                            Content="Dismiss"
                            Command="{x:Bind ViewModel.DismissSuggestionCommand}"
                            MinWidth="80"
                            VerticalAlignment="Center"
                            AutomationProperties.Name="Dismiss mode suggestion"/>
                </Grid>
            </Border>

            <!-- Mode Intelligence: free locked teaser → paywall -->
            <Border Grid.Row="2"
                    Visibility="{x:Bind ViewModel.ShowModeSuggestionLocked, Mode=OneWay}"
                    Background="{StaticResource ModeIntelligenceLockedBrush}"
                    BorderBrush="{StaticResource PepinilloPremiumBadgeBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource PepinilloCardCornerRadius}"
                    Padding="{StaticResource PepinilloCardPaddingCompact}"
                    Margin="0,0,0,16"
                    AutomationProperties.Name="Mode Intelligence upgrade teaser">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                    <FontIcon Grid.Column="0"
                              Glyph="&#xE72E;"
                              FontSize="18"
                              Foreground="{StaticResource PepinilloPremiumBadgeBrush}"
                              VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                        <TextBlock Text="Mode Intelligence"
                                   FontWeight="SemiBold"
                                   Style="{ThemeResource BodyTextBlockStyle}"
                                   Foreground="{StaticResource PepinilloPremiumBadgeBrush}"/>
                        <TextBlock Text="{x:Bind ViewModel.SuggestionReason, Mode=OneWay}"
                                   Style="{ThemeResource CaptionTextBlockStyle}"
                                   TextWrapping="Wrap"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>
                    <Button Grid.Column="2"
                            Content="Upgrade"
                            Style="{ThemeResource AccentButtonStyle}"
                            Command="{x:Bind ViewModel.UpgradeModeIntelligenceCommand}"
                            MinWidth="96"
                            VerticalAlignment="Center"
                            AutomationProperties.Name="Upgrade for Mode Intelligence"/>
                </Grid>
            </Border>

            <Border Grid.Row="3"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    CornerRadius="{StaticResource PepinilloTimerCardCornerRadius}"
                    Padding="32"
                    Margin="0,0,0,24"
                    HorizontalAlignment="Center"
                    MinWidth="320">
                <StackPanel Spacing="16" HorizontalAlignment="Center">
                    <TextBlock Text="{x:Bind ViewModel.FormattedTime, Mode=OneWay}"
                               FontSize="{StaticResource PepinilloTimerFontSize}"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"
                               FontFamily="Segoe UI Variable Display"
                               Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                    <ProgressBar Value="{x:Bind ViewModel.ProgressRatio, Mode=OneWay}"
                                 Maximum="1"
                                 Height="8"
                                 Width="240"
                                 Foreground="{StaticResource PepinilloThemeAccentBrush}"/>
                    <TextBlock Text="{x:Bind ViewModel.LastCompletedMessage, Mode=OneWay}"
                               Style="{ThemeResource CaptionTextBlockStyle}"
                               HorizontalAlignment="Center"
                               Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}"/>
                </StackPanel>
            </Border>

            <StackPanel Grid.Row="4"
                        Orientation="Horizontal"
                        Spacing="12"
                        HorizontalAlignment="Center"
                        Margin="0,0,0,24">
                <Button Content="{x:Bind ViewModel.StartLabel, Mode=OneWay}"
                        Style="{ThemeResource AccentButtonStyle}"
                        Command="{x:Bind ViewModel.StartSessionCommand}"
                        IsEnabled="{x:Bind ViewModel.CanStart, Mode=OneWay}"
                        MinWidth="140"/>
                <Button Content="{x:Bind ViewModel.PauseLabel, Mode=OneWay}"
                        Command="{x:Bind ViewModel.PauseSessionCommand}"
                        IsEnabled="{x:Bind ViewModel.CanPause, Mode=OneWay}"
                        MinWidth="100"/>
                <Button Content="{x:Bind ViewModel.StopLabel, Mode=OneWay}"
                        Command="{x:Bind ViewModel.StopSessionCommand}"
                        MinWidth="100"/>
                <Button Content="{x:Bind ViewModel.SkipLabel, Mode=OneWay}"
                        Command="{x:Bind ViewModel.SkipBreakCommand}"
                        IsEnabled="{x:Bind ViewModel.CanSkip, Mode=OneWay}"
                        MinWidth="100"/>
                <Button Content="Mini timer"
                        Click="MiniTimer_Click"
                        ToolTipService.ToolTip="Toggle compact mini timer (Win+Shift+M)"
                        MinWidth="100"/>
            </StackPanel>

            <Border Grid.Row="5"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    CornerRadius="{StaticResource PepinilloCardCornerRadius}"
                    Padding="{StaticResource PepinilloCardPaddingCompact}"
                    Margin="0,0,0,16">
                <StackPanel Spacing="8">
                    <TextBlock Text="{x:Bind ViewModel.LinkTaskLabel, Mode=OneWay}"
                               Style="{ThemeResource SubtitleTextBlockStyle}"/>
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <ComboBox x:Name="TaskCombo"
                                  Grid.Column="0"
                                  HorizontalAlignment="Stretch"
                                  PlaceholderText="Free focus"
                                  ItemsSource="{x:Bind ViewModel.AvailableTasks, Mode=OneWay}"
                                  SelectionChanged="TaskCombo_SelectionChanged">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="models:TaskItem">
                                    <TextBlock Text="{x:Bind Title}"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <Button Grid.Column="1"
                                Content="Clear"
                                Command="{x:Bind ViewModel.ClearLinkedTaskCommand}"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Post-session journal (panel always in tree; status text indicates when empty) -->
            <Border Grid.Row="6"
                    x:Name="JournalPanel"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    CornerRadius="{StaticResource PepinilloCardCornerRadius}"
                    Padding="{StaticResource PepinilloCardPaddingCompact}">
                <StackPanel Spacing="12">
                    <TextBlock Text="{x:Bind ViewModel.JournalTitleLabel, Mode=OneWay}"
                               Style="{ThemeResource SubtitleTextBlockStyle}"
                               FontWeight="SemiBold"/>
                    <TextBlock Text="{x:Bind ViewModel.LastCompletedMessage, Mode=OneWay}"
                               Style="{ThemeResource CaptionTextBlockStyle}"/>
                    <TextBox Header="What went well / notes"
                             Text="{x:Bind ViewModel.JournalNoteDraft, Mode=TwoWay}"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             MinHeight="80"/>
                    <NumberBox Header="Energy rating (1-5, optional)"
                               Value="{x:Bind ViewModel.JournalEnergyRating, Mode=TwoWay}"
                               Minimum="0"
                               Maximum="5"
                               SmallChange="1"
                               SpinButtonPlacementMode="Compact"
                               Width="160"
                               HorizontalAlignment="Left"/>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="Save journal"
                                Style="{ThemeResource AccentButtonStyle}"
                                Command="{x:Bind ViewModel.SaveJournalCommand}"
                                IsEnabled="{x:Bind ViewModel.ShowJournalPanel, Mode=OneWay}"/>
                        <Button Content="Dismiss"
                                Command="{x:Bind ViewModel.DismissJournalCommand}"
                                IsEnabled="{x:Bind ViewModel.ShowJournalPanel, Mode=OneWay}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</Page>
