<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Layout tokens -->
    <CornerRadius x:Key="PepinilloCardCornerRadius">12</CornerRadius>
    <CornerRadius x:Key="PepinilloChipCornerRadius">8</CornerRadius>
    <CornerRadius x:Key="PepinilloTimerCardCornerRadius">16</CornerRadius>
    <Thickness x:Key="PepinilloPageMargin">32</Thickness>
    <Thickness x:Key="PepinilloCardPadding">20</Thickness>
    <Thickness x:Key="PepinilloCardPaddingCompact">16</Thickness>
    <x:Double x:Key="PepinilloSectionSpacing">24</x:Double>
    <x:Double x:Key="PepinilloChipSpacing">8</x:Double>
    <x:Double x:Key="PepinilloTimerFontSize">64</x:Double>
    <x:Double x:Key="PepinilloMiniTimerFontSize">28</x:Double>

    <!-- Mode colors: Pomodoro=red, Time Block=purple, Stopwatch=green, Flowtime=teal -->
    <Color x:Key="FocusModePomodoroColor">#E53935</Color>
    <Color x:Key="FocusModeTimeBlockColor">#8E24AA</Color>
    <Color x:Key="FocusModeStopwatchColor">#43A047</Color>
    <Color x:Key="FocusModeFlowtimeColor">#00897B</Color>

    <SolidColorBrush x:Key="FocusModePomodoroBrush" Color="{StaticResource FocusModePomodoroColor}"/>
    <SolidColorBrush x:Key="FocusModeTimeBlockBrush" Color="{StaticResource FocusModeTimeBlockColor}"/>
    <SolidColorBrush x:Key="FocusModeStopwatchBrush" Color="{StaticResource FocusModeStopwatchColor}"/>
    <SolidColorBrush x:Key="FocusModeFlowtimeBrush" Color="{StaticResource FocusModeFlowtimeColor}"/>

    <!-- Subtle mode chip backgrounds -->
    <SolidColorBrush x:Key="FocusModePomodoroSubtleBrush" Color="#33E53935"/>
    <SolidColorBrush x:Key="FocusModeTimeBlockSubtleBrush" Color="#338E24AA"/>
    <SolidColorBrush x:Key="FocusModeStopwatchSubtleBrush" Color="#3343A047"/>
    <SolidColorBrush x:Key="FocusModeFlowtimeSubtleBrush" Color="#3300897B"/>

    <!-- Semantic accents (ThemeHelper overwrites named-theme keys at runtime) -->
    <Color x:Key="PepinilloThemeAccentColor">#0078D4</Color>
    <SolidColorBrush x:Key="PepinilloThemeAccentBrush" Color="{StaticResource PepinilloThemeAccentColor}"/>
    <SolidColorBrush x:Key="PepinilloAccentBrush" Color="{StaticResource PepinilloThemeAccentColor}"/>
    <SolidColorBrush x:Key="PepinilloPaywallHintBrush" Color="#C9A227"/>
    <SolidColorBrush x:Key="PepinilloPremiumBadgeBrush" Color="#C9A227"/>
    <SolidColorBrush x:Key="PepinilloStreakBrush" Color="#FF6D00"/>
    <SolidColorBrush x:Key="PepinilloOledSurfaceBrush" Color="#000000"/>

    <!-- Mode Intelligence banner (W5) -->
    <Color x:Key="ModeIntelligenceAccentColor">#C9A227</Color>
    <SolidColorBrush x:Key="ModeIntelligenceAccentBrush" Color="{StaticResource ModeIntelligenceAccentColor}"/>
    <SolidColorBrush x:Key="ModeIntelligenceBannerBrush" Color="#1AC9A227"/>
    <SolidColorBrush x:Key="ModeIntelligenceLockedBrush" Color="#26C9A227"/>

    <Color x:Key="ThemeForestAccentColor">#2E7D32</Color>
    <Color x:Key="ThemeOceanAccentColor">#0277BD</Color>
    <Color x:Key="ThemeSunsetAccentColor">#EF6C00</Color>
    <Color x:Key="ThemeDarkAccentColor">#60CDFF</Color>
    <Color x:Key="ThemeLightAccentColor">#0078D4</Color>

</ResourceDictionary>
