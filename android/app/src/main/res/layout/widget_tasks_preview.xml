<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_preview_bg"
    android:padding="12dp">

    <!-- Header -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Tasks (3)"
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="#212121"
        android:drawablePadding="4dp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#E0E0E0"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="6dp" />

    <!-- Task 1 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingVertical="4dp">

        <View
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:background="@drawable/widget_task_check_bg" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Review pull requests"
            android:textSize="13sp"
            android:textColor="#424242"
            android:layout_marginStart="8dp"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="2/4"
            android:textSize="11sp"
            android:textColor="#9E9E9E" />
    </LinearLayout>

    <!-- Task 2 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingVertical="4dp">

        <View
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:background="@drawable/widget_task_check_bg" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Write documentation"
            android:textSize="13sp"
            android:textColor="#424242"
            android:layout_marginStart="8dp"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0/2"
            android:textSize="11sp"
            android:textColor="#9E9E9E" />
    </LinearLayout>

    <!-- Task 3 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingVertical="4dp">

        <View
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:background="@drawable/widget_task_check_bg" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Deploy to staging"
            android:textSize="13sp"
            android:textColor="#424242"
            android:layout_marginStart="8dp"
            android:maxLines="1"
            android:ellipsize="end" />
    </LinearLayout>

</LinearLayout>
