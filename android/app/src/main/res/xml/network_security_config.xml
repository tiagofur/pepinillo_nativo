<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Allow cleartext only in debug builds (handled by manifest debuggable flag) -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>

    <!-- Pin the production API domain -->
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="true">api.ppn.creapolis.dev</domain>
        <domain includeSubdomains="true">creapolis.dev</domain>
    </domain-config>

    <!-- Allow cleartext for localhost in debug -->
    <debug-overrides>
        <trust-anchors>
            <certificates src="user" />
            <certificates src="system" />
        </trust-anchors>
    </debug-overrides>
</network-security-config>
