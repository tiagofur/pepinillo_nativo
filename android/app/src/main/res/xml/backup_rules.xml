<?xml version="1.0" encoding="utf-8"?>
<full-backup-content>
    <!-- Include general shared prefs (non-sensitive) -->
    <include domain="sharedpref" path="." />

    <!-- Exclude encrypted auth tokens - they cannot be restored on another device -->
    <exclude domain="sharedpref" path="pepinillo_auth.xml" />
    <exclude domain="sharedpref" path="__androidx_security_crypto_encrypted_prefs__.xml" />

    <!-- Exclude the Room database - it syncs from server on login -->
    <exclude domain="database" path="pepinillo.db" />
    <exclude domain="database" path="pepinillo.db-wal" />
    <exclude domain="database" path="pepinillo.db-shm" />
</full-backup-content>