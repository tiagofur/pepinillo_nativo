<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- N days — used by streak cards and dashboard day counts -->
    <plurals name="days_count">
        <item quantity="one">%d day</item>
        <item quantity="other">%d days</item>
    </plurals>

    <!-- N sessions — used by streak/weekly chart preview lines -->
    <plurals name="sessions_count">
        <item quantity="one">%d session</item>
        <item quantity="other">%d sessions</item>
    </plurals>

    <!-- N active tasks (TasksScreen counter) -->
    <plurals name="tasks_active_count">
        <item quantity="one">%d active</item>
        <item quantity="other">%d active</item>
    </plurals>

    <!-- AI credits remaining (AIReportScreen) -->
    <plurals name="ai_credits_left">
        <item quantity="one">%d credit left this month</item>
        <item quantity="other">%d credits left this month</item>
    </plurals>

    <!-- Last-sync relative time (SettingsScreen) -->
    <plurals name="settings_sync_min_ago">
        <item quantity="one">%d min ago</item>
        <item quantity="other">%d min ago</item>
    </plurals>
    <plurals name="settings_sync_hr_ago">
        <item quantity="one">%d hr ago</item>
        <item quantity="other">%d hr ago</item>
    </plurals>
    <plurals name="settings_sync_days_ago">
        <item quantity="one">%d day ago</item>
        <item quantity="other">%d days ago</item>
    </plurals>

    <!-- Duration parts for formatMinutes/formatMonthlyMinutes -->
    <plurals name="duration_hours">
        <item quantity="one">%d h</item>
        <item quantity="other">%d h</item>
    </plurals>
    <plurals name="duration_minutes">
        <item quantity="one">%d min</item>
        <item quantity="other">%d min</item>
    </plurals>
</resources>
