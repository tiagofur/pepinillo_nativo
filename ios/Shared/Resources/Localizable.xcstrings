      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple decide si compartir tu nombre y correo al iniciar sesión con Apple. La fecha de nacimiento y la foto de perfil se gestionan manualmente en Pepinillo, y puedes seguir usando un correo relay privado o reemplazarlo aquí."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Apple decide se compartilha seu nome e e-mail ao entrar com Apple. A data de nascimento e a foto de perfil são gerenciadas manualmente no Pepinillo, e você pode continuar usando um e-mail relay privado ou substituí-lo aqui."
          }
        }
      }
    },
