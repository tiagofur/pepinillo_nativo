    "editprofile.applesignin.explanation" : {
      "comment" : "EditProfileView — Apple Sign In explanation paragraph",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple decides whether to share your name and email during Sign in with Apple. Birth date and profile photo are managed manually in Pepinillo, and you can keep using a private relay email or replace it locally here."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple decide si compartir tu nombre y correo durante el inicio con Apple. La fecha de nacimiento y la foto de perfil se gestionan manualmente en Pepinillo, y puedes seguir usando un correo relay privado o reemplazarlo aquí."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Apple decide se compartilha seu nome e e-mail durante o Sign in with Apple. Data de nascimento e foto de perfil são gerenciadas manualmente no Pepinillo, e você pode continuar usando um e-mail relay privado ou substituí-lo aqui."
          }
        }
      }
    },
