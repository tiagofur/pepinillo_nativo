    "Pepinillo+" : {
      "comment" : "Human-readable name for the Pepinillo+ tier.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pepinillo+"
