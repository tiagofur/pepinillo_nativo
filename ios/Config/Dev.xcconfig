// Dev.xcconfig — Local development against backend on localhost.

#include "Shared.xcconfig"

// Use a simulator-friendly host. Physical devices cannot reach `localhost`
// on the host Mac — override to your LAN IP on the command line if needed.
API_BASE_URL = http:$(SLASH_SLASH)localhost:8080/api/v1
WS_BASE_URL = ws:$(SLASH_SLASH)localhost:8080/api/v1/ws

APP_ENVIRONMENT = dev

// Sentry is disabled in Dev by default — fill in a DSN locally if you want to
// test error reporting during development.
SENTRY_DSN =
