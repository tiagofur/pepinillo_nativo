// Shared.xcconfig — Base settings shared across Dev / Staging / Production.
//
// Per-environment configs (Dev / Staging / Production) #include this file and
// override API_BASE_URL / WS_BASE_URL as needed.
//
// DEVELOPMENT_TEAM is defined here as a placeholder so all targets inherit the
// same signing team. Replace with your real Apple Developer Team ID.

// TODO: replace with real Apple Developer Team ID before archiving for App Store
DEVELOPMENT_TEAM = T5SKULSP2M

// xcconfig gotcha: `//` starts a comment anywhere in a value, so a value of
// `//` would define an EMPTY variable (that is exactly what broke every
// API_BASE_URL/WS_BASE_URL since 2026-04: "https:api..." with no scheme
// separator). Workaround: define a SINGLE slash and substitute it twice.
// Usage: https:$(SLASH_SLASH)$(SLASH_SLASH)host/path
SLASH_SLASH = /

// Sentry crash reporting DSN. Empty by default — each environment xcconfig
// sets its own value. Exposed through Info.plist SENTRY_DSN and read at
// launch by SentryService. Empty value = Sentry disabled.
SENTRY_DSN =

// RevenueCat API key. Loaded from the gitignored Secrets.xcconfig.
// The '?' makes a missing file non-fatal so CI builds without a secrets file
// still compile (AppFeature.swift already fails-safe when the key is empty).
// To set up locally: copy ios/Config/Secrets.xcconfig.template to
// ios/Config/Secrets.xcconfig and fill in REVENUECAT_API_KEY.
#include? "Secrets.xcconfig"
