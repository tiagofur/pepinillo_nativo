# Application Environment
APP_ENV=production
PORT=8080
CORS_ALLOWED_ORIGINS=https://api.ppn.creapolis.dev

# Database Configuration
# For Docker Compose: postgres://pepinillo:{POSTGRES_PASSWORD}@db:5432/pepinillo?sslmode=disable
# The POSTGRES_PASSWORD must be set in .env.production as well
DATABASE_URL=postgres://pepinillo:CHANGEME_POSTGRES_PASSWORD@db:5432/pepinillo?sslmode=disable

# Database connection pool (Track A4 — production hygiene)
# Tune these when scaling horizontally. MAX_OPEN_CONNS * replicas must stay
# below Postgres max_connections minus headroom for migrations/ops.
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_LIFETIME_SECONDS=3600
DB_CONN_MAX_IDLE_TIME_SECONDS=1800

# Redis Configuration
# For Docker Compose: redis://redis:6379
REDIS_URL=redis://redis:6379

# JWT Configuration
JWT_SECRET=CHANGEME_GENERATE_STRONG_SECRET_HERE
JWT_ISSUER=pepinillo-api
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000

# MinIO (S3-compatible object storage) - Optional for production
# If using external S3, update these values accordingly
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=CHANGEME_MINIO_ACCESS_KEY
MINIO_SECRET_KEY=CHANGEME_MINIO_SECRET_KEY
MINIO_BUCKET=profiles
MINIO_USE_SSL=false
MINIO_PUBLIC_BASE_URL=https://api.ppn.creapolis.dev/minio

# Machine Learning / LLM Configuration
LLM_PROVIDER=openai
LLM_API_KEY=
ML_SERVICE_URL=http://ml-service:8001
GEMINI_API_KEY=

# Email Service Configuration (SendGrid)
EMAIL_PROVIDER=sendgrid
SENDGRID_API_KEY=CHANGEME_SENDGRID_API_KEY
SENDGRID_FROM_EMAIL=noreply@pepinillo.app
SENDGRID_FROM_NAME=Pepinillo

# OAuth Configuration
GOOGLE_CLIENT_IDS=your-android-or-web-client-id.apps.googleusercontent.com,your-ios-client-id.apps.googleusercontent.com
APPLE_BUNDLE_ID=dev.creapolis.pepinillo

# Google Play Billing (Android)
GOOGLE_PLAY_PACKAGE_NAME=dev.creapolis.pepinillo
GOOGLE_PLAY_API_TOKEN=
GOOGLE_PLAY_API_BASE_URL=https://androidpublisher.googleapis.com
GOOGLE_PLAY_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PLAY_SERVICE_ACCOUNT_PRIVATE_KEY=
GOOGLE_PLAY_OAUTH_TOKEN_URL=https://oauth2.googleapis.com/token
GOOGLE_PLAY_OAUTH_SCOPE=https://www.googleapis.com/auth/androidpublisher

# App Store Billing (iOS)
APP_STORE_SHARED_SECRET=
APP_STORE_VERIFY_RECEIPT_URL=https://buy.itunes.apple.com/verifyReceipt
APP_STORE_SANDBOX_VERIFY_RECEIPT_URL=https://sandbox.itunes.apple.com/verifyReceipt
APP_STORE_SERVER_API_ISSUER_ID=
APP_STORE_SERVER_API_KEY_ID=
APP_STORE_SERVER_API_PRIVATE_KEY=
APP_STORE_SERVER_API_BUNDLE_ID=dev.creapolis.pepinillo
APP_STORE_SERVER_API_BASE_URL=https://api.storekit.itunes.apple.com

# RevenueCat Configuration (optional - for unified billing)
REVENUECAT_API_KEY=
REVENUECAT_SECRET_KEY=
REVENUECAT_WEBHOOK_AUTH_TOKEN=
REVENUECAT_API_BASE_URL=https://api.revenuecat.com/v1

# Push Notifications Configuration
PUSH_PROVIDER=noop
FCM_PROJECT_ID=
FCM_SERVICE_ACCOUNT_EMAIL=
FCM_SERVICE_ACCOUNT_PRIVATE_KEY=
FCM_OAUTH_TOKEN_URL=https://oauth2.googleapis.com/token
FCM_OAUTH_SCOPE=https://www.googleapis.com/auth/firebase.messaging
FCM_API_BASE_URL=https://fcm.googleapis.com
APNS_TEAM_ID=
APNS_KEY_ID=
APNS_PRIVATE_KEY=
APNS_TOPIC=dev.creapolis.pepinillo
APNS_BASE_URL=https://api.push.apple.com

# Alerting Configuration
ALERT_BILLING_MIN_SAMPLES=5
ALERT_BILLING_FAILURE_RATIO_WARN_PCT=20
ALERT_BILLING_FAILURE_RATIO_CRITICAL_PCT=40
ALERT_PUSH_FAILURE_RATIO_WARN_PCT=20
ALERT_PUSH_FAILURE_RATIO_CRITICAL_PCT=40
ALERT_RECURRENCE_FAILURE_RATIO_WARN_PCT=20
ALERT_RECURRENCE_FAILURE_RATIO_CRITICAL_PCT=40
ALERT_COOLDOWN_SECONDS=300
ALERT_MUTE_WINDOW_ENABLED=false
ALERT_MUTE_START_HOUR_UTC=0
ALERT_MUTE_END_HOUR_UTC=0

# Refresh Token Hash Key (Track A2 — security hardening)
# HMAC-SHA-256 key used to hash refresh tokens before persisting them. MUST
# be at least 32 bytes. REQUIRED in production — boot will abort if missing.
# Generate with: openssl rand -base64 48
# Rotate this by: (1) deploy with both old and new Redis instances warm, or
# (2) accept one forced re-login (simpler). Never commit this value.
REFRESH_TOKEN_HASH_KEY=CHANGEME_GENERATE_32_PLUS_BYTES_HERE


# WebSocket Authentication (Track A2 — security hardening)
# Keep false in production. Set to true only during a transitional rollout
# when legacy clients still send the JWT as a query param. Removal: v1.1.
DEPRECATED_WS_QUERY_AUTH=false
