APP_ENV=development
PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8081

DATABASE_URL=postgres://postgres:postgres@postgres:5432/pepinillo?sslmode=disable
# Database connection pool (Track A4 — production hygiene)
# Defaults are tuned for a single API replica; increase MAX_OPEN_CONNS when
# you scale horizontally or enable connection-heavy features.
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_LIFETIME_SECONDS=3600
DB_CONN_MAX_IDLE_TIME_SECONDS=1800
REDIS_URL=redis://redis:6379

JWT_SECRET=change_me_super_secret
JWT_ISSUER=pepinillo-api
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000

MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=profiles
MINIO_USE_SSL=false
MINIO_PUBLIC_BASE_URL=http://localhost:9000

LLM_PROVIDER=openai
LLM_API_KEY=
ML_SERVICE_URL=http://ml-service:8001

GEMINI_API_KEY=

# Email Service
EMAIL_PROVIDER=sendgrid
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=noreply@pepinillo.app
SENDGRID_FROM_NAME=Pepinillo

# OAuth audience validation
GOOGLE_CLIENT_IDS=your-google-client-id.apps.googleusercontent.com
APPLE_BUNDLE_ID=dev.creapolis.pepinillo

# Billing verification providers
GOOGLE_PLAY_PACKAGE_NAME=
GOOGLE_PLAY_API_TOKEN=
GOOGLE_PLAY_API_BASE_URL=https://androidpublisher.googleapis.com
GOOGLE_PLAY_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PLAY_SERVICE_ACCOUNT_PRIVATE_KEY=
GOOGLE_PLAY_OAUTH_TOKEN_URL=https://oauth2.googleapis.com/token
GOOGLE_PLAY_OAUTH_SCOPE=https://www.googleapis.com/auth/androidpublisher
APP_STORE_SHARED_SECRET=
APP_STORE_VERIFY_RECEIPT_URL=https://buy.itunes.apple.com/verifyReceipt
APP_STORE_SANDBOX_VERIFY_RECEIPT_URL=https://sandbox.itunes.apple.com/verifyReceipt
APP_STORE_SERVER_API_ISSUER_ID=
APP_STORE_SERVER_API_KEY_ID=
APP_STORE_SERVER_API_PRIVATE_KEY=
APP_STORE_SERVER_API_BUNDLE_ID=
APP_STORE_SERVER_API_BASE_URL=https://api.storekit.itunes.apple.com

# Push notifications
PUSH_PROVIDER=noop
FCM_PROJECT_ID=
FCM_SERVICE_ACCOUNT_EMAIL=
FCM_SERVICE_ACCOUNT_PRIVATE_KEY=
FCM_OAUTH_TOKEN_URL=https://oauth2.googleapis.com/token
FCM_OAUTH_SCOPE=https://www.googleapis.com/auth/firebase.messaging
FCM_API_BASE_URL=https://fcm.googleapis.com
APNS_TEAM_ID=
APNS_KEY_ID=
APNS_PRIVATE_KEY=
APNS_TOPIC=
APNS_BASE_URL=https://api.push.apple.com

# Alerting (health/alerts)
ALERT_BILLING_MIN_SAMPLES=5
ALERT_BILLING_FAILURE_RATIO_WARN_PCT=20
ALERT_BILLING_FAILURE_RATIO_CRITICAL_PCT=40
ALERT_PUSH_FAILURE_RATIO_WARN_PCT=20
ALERT_PUSH_FAILURE_RATIO_CRITICAL_PCT=40
ALERT_RECURRENCE_FAILURE_RATIO_WARN_PCT=20
ALERT_RECURRENCE_FAILURE_RATIO_CRITICAL_PCT=40
ALERT_COOLDOWN_SECONDS=300
ALERT_MUTE_WINDOW_ENABLED=false
ALERT_MUTE_START_HOUR_UTC=0
ALERT_MUTE_END_HOUR_UTC=0

# Refresh token hash key (Track A2 — security hardening)
# HMAC-SHA-256 key used to hash refresh tokens before storing them in Redis
# or the in-memory fallback. Required in production and must be at least 32
# bytes. Generate with: openssl rand -base64 48
REFRESH_TOKEN_HASH_KEY=


# WebSocket authentication (Track A2 — security hardening)
# Set to true to keep accepting the legacy ?token= query-param fallback while
# native clients migrate to the Authorization header. This flag is scheduled
# for removal in v1.1. Leave false in production once clients are updated.
DEPRECATED_WS_QUERY_AUTH=false

# Observability (Track A3 — structured logging & error tracking)
# LOG_LEVEL: debug | info | warn | error. Default: info. Unknown values
#   silently fall back to info so a typo never silences the logs.
# SENTRY_DSN: empty disables Sentry (dev default). Set to your project DSN
#   in production. See https://docs.sentry.io/platforms/go/.
# SENTRY_SAMPLE_RATE: fraction of errors captured (0..1). Default 1.0.
# SENTRY_TRACES_SAMPLE_RATE: fraction of traces captured (0..1). Default 0.1.
# SENTRY_RELEASE: optional release tag (e.g. git sha) to tag events.
LOG_LEVEL=info
SENTRY_DSN=
SENTRY_SAMPLE_RATE=1.0
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_RELEASE=
