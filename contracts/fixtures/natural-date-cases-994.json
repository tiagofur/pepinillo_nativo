{
  "issue": 994,
  "description": "Shared grammar cases for a planned date typed at the END of capture text (#994 S1/S2). Weekday numbers are ISO (1=Mon..7=Sun). fixedNow is interpreted in the DEVICE local timezone: every suite must build it from these local components (2026-11-27 is a Friday). expectedDate kinds: \"today\" | \"tomorrow\" | \"dayAfterTomorrow\" | {\"kind\":\"nextWeekday\",\"weekday\":N} | {\"kind\":\"explicit\",\"year\":Y,\"month\":M,\"day\":D}. expectedDate null = no date at all; the title must be kept byte-identical. Numeric dates are always day/month (dd/mm) — month/day is never interpreted. A trailing punctuation mark (. , ! ?) travels with the date, and so does the preposition/article immediately before it (el, del, para el, on, for, by, na, no, em, ...).",
  "fixedNow": { "year": 2026, "month": 11, "day": 27, "hour": 12, "minute": 0 },
  "cases": [
    { "name": "es: weekday with article strips it (today is Friday → next week)", "input": "Enviar informe el viernes", "expectedTitle": "Enviar informe", "expectedDate": { "kind": "nextWeekday", "weekday": 5 } },
    { "name": "es: weekday strictly future resolves to tomorrow", "input": "Informe el sábado", "expectedTitle": "Informe", "expectedDate": { "kind": "nextWeekday", "weekday": 6 } },
    { "name": "es: tomorrow bare", "input": "Comprar mañana", "expectedTitle": "Comprar", "expectedDate": "tomorrow" },
    { "name": "es: today bare", "input": "Regar las plantas hoy", "expectedTitle": "Regar las plantas", "expectedDate": "today" },
    { "name": "es: past tomorrow", "input": "Entregar el informe pasado mañana", "expectedTitle": "Entregar el informe", "expectedDate": "dayAfterTomorrow" },
    { "name": "es: monday next week", "input": "Reunión con Ana el lunes", "expectedTitle": "Reunión con Ana", "expectedDate": { "kind": "nextWeekday", "weekday": 1 } },
    { "name": "es: compound preposition «para el» travels with the date", "input": "Enviar informe para el viernes", "expectedTitle": "Enviar informe", "expectedDate": { "kind": "nextWeekday", "weekday": 5 } },
    { "name": "es: «del» travels with the date", "input": "Informe del viernes", "expectedTitle": "Informe", "expectedDate": { "kind": "nextWeekday", "weekday": 5 } },
    { "name": "es: «el próximo» travels with the date", "input": "Enviar informe el próximo viernes", "expectedTitle": "Enviar informe", "expectedDate": { "kind": "nextWeekday", "weekday": 5 } },
    { "name": "es: dd/mm future this year", "input": "Informe 3/12", "expectedTitle": "Informe", "expectedDate": { "kind": "explicit", "year": 2026, "month": 12, "day": 3 } },
    { "name": "es: dd/mm already past rolls to next year", "input": "Pagar renta 1/1", "expectedTitle": "Pagar renta", "expectedDate": { "kind": "explicit", "year": 2027, "month": 1, "day": 1 } },
    { "name": "es: dd/mm/yyyy explicit", "input": "Evento 15/3/2027", "expectedTitle": "Evento", "expectedDate": { "kind": "explicit", "year": 2027, "month": 3, "day": 15 } },
    { "name": "es: ISO yyyy-mm-dd explicit", "input": "Cierre 2026-12-25", "expectedTitle": "Cierre", "expectedDate": { "kind": "explicit", "year": 2026, "month": 12, "day": 25 } },
    { "name": "es: trailing punctuation travels with the date", "input": "Enviar informe el viernes.", "expectedTitle": "Enviar informe", "expectedDate": { "kind": "nextWeekday", "weekday": 5 } },
    { "name": "es: morning guard blocks the parse", "input": "Café de la mañana", "expectedTitle": "Café de la mañana", "expectedDate": null },
    { "name": "es: weekday mid-text never parses (S5 regression)", "input": "Reunión lunes de estrategia", "expectedTitle": "Reunión lunes de estrategia", "expectedDate": null },
    { "name": "es: weekday at the start never parses (S5 regression)", "input": "Viernes de rollout", "expectedTitle": "Viernes de rollout", "expectedDate": null },
    { "name": "es: plain numbers are not dates", "input": "Comprar 3 panes y leche", "expectedTitle": "Comprar 3 panes y leche", "expectedDate": null },
    { "name": "es: impossible numeric date is left alone", "input": "Informe 32/13", "expectedTitle": "Informe 32/13", "expectedDate": null },
    { "name": "es: uppercase input keeps its casing minus the match", "input": "INFORME EL VIERNES", "expectedTitle": "INFORME", "expectedDate": { "kind": "nextWeekday", "weekday": 5 } },
    { "name": "en: on Friday", "input": "Send report on Friday", "expectedTitle": "Send report", "expectedDate": { "kind": "nextWeekday", "weekday": 5 } },
    { "name": "en: tomorrow", "input": "Buy groceries tomorrow", "expectedTitle": "Buy groceries", "expectedDate": "tomorrow" },
    { "name": "en: today", "input": "Call mom today", "expectedTitle": "Call mom", "expectedDate": "today" },
    { "name": "en: day after tomorrow", "input": "Ship it day after tomorrow", "expectedTitle": "Ship it", "expectedDate": "dayAfterTomorrow" },
    { "name": "en: Monday with article", "input": "Meeting on Monday", "expectedTitle": "Meeting", "expectedDate": { "kind": "nextWeekday", "weekday": 1 } },
    { "name": "en: «for» travels with the date", "input": "Report for Friday", "expectedTitle": "Report", "expectedDate": { "kind": "nextWeekday", "weekday": 5 } },
    { "name": "en: 3/12 is day/month (never March 12)", "input": "Pay rent 3/12", "expectedTitle": "Pay rent", "expectedDate": { "kind": "explicit", "year": 2026, "month": 12, "day": 3 } },
    { "name": "en: ISO explicit", "input": "Deploy 2026-12-31", "expectedTitle": "Deploy", "expectedDate": { "kind": "explicit", "year": 2026, "month": 12, "day": 31 } },
    { "name": "en: weekday not at the end never parses", "input": "Friday rollout", "expectedTitle": "Friday rollout", "expectedDate": null },
    { "name": "en: no date at all", "input": "Weekly sync", "expectedTitle": "Weekly sync", "expectedDate": null },
    { "name": "en: exclamation mark travels with the date", "input": "Buy milk tomorrow!", "expectedTitle": "Buy milk", "expectedDate": "tomorrow" },
    { "name": "pt: «na sexta» strips the article", "input": "Enviar relatório na sexta", "expectedTitle": "Enviar relatório", "expectedDate": { "kind": "nextWeekday", "weekday": 5 } },
    { "name": "pt: amanhã with accent", "input": "Comprar pão amanhã", "expectedTitle": "Comprar pão", "expectedDate": "tomorrow" },
    { "name": "pt: hoje", "input": "Ligar para a mãe hoje", "expectedTitle": "Ligar para a mãe", "expectedDate": "today" },
    { "name": "pt: segunda-feira compound weekday", "input": "Reunião segunda-feira", "expectedTitle": "Reunião", "expectedDate": { "kind": "nextWeekday", "weekday": 1 } },
    { "name": "pt: depois de amanhã", "input": "Entregar depois de amanhã", "expectedTitle": "Entregar", "expectedDate": "dayAfterTomorrow" },
    { "name": "pt: unaccented amanha variant", "input": "Comprar pao amanha", "expectedTitle": "Comprar pao", "expectedDate": "tomorrow" },
    { "name": "pt: morning guard «da manhã» blocks the parse", "input": "Comprar café da manhã", "expectedTitle": "Comprar café da manhã", "expectedDate": null },
    { "name": "pt: «semana» is not a date token", "input": "Reunião na próxima semana", "expectedTitle": "Reunião na próxima semana", "expectedDate": null },
    { "name": "pt: weekday at the start never parses", "input": "Sexta entrega", "expectedTitle": "Sexta entrega", "expectedDate": null },
    { "name": "bare numeric date with no title left stays untouched", "input": "3/12", "expectedTitle": "3/12", "expectedDate": null },
    { "name": "bare phrase with no title left stays untouched", "input": "mañana", "expectedTitle": "mañana", "expectedDate": null }
  ]
}
